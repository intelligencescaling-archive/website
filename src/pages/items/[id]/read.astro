---
// Reader view ("Book"): the full text of a text-only entry (no PDF/DOCX/EPUB to open instead), all
// chapters on one page in scroll mode. The text is untrusted: it is only ever rendered through Astro
// expressions (escaped), never set:html. Settings, progress, chapters and resume are in
// src/scripts/reader.js; without JavaScript the page is just the text.
import Base from '../../../layouts/Base.astro';
import { loadArchive, hasReader, readerChapters, authorLabel, formatNumber } from '../../../lib/archive.mjs';

export function getStaticPaths() {
  return loadArchive()
    .entries.filter(hasReader)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry: e } = Astro.props as { entry: any };
const chapters = readerChapters(e);
const multi = chapters.length > 1;
const unit = e.category === 'story' ? 'Chapter' : 'Part';
const words = chapters.reduce((n: number, c: any) => n + c.words, 0);
const minutes = Math.max(1, Math.round(words / 230));
const readTime = minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} h ${minutes % 60} min`;
const itemHref = `/items/${e.id}/`;
// Headings from the text sit one level under the chapter heading.
const base = multi ? 3 : 2;
const tagFor = (level: number) => (level === 0 ? 'p' : `h${Math.min(base + level - 1, 6)}`);
---
<Base title={`Read: ${e.title}`} description={`Read ${e.title} by ${authorLabel(e)} on the Intelligence Scaling Archive.`} ogType="article">
  <meta slot="head" name="robots" content="noindex, follow" />
  <div class="reader" id="reader" data-id={e.id} data-unit={unit}>
    <div class="r-bar">
      <a class="r-icon" href={itemHref} aria-label="Back to the item page">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </a>
      <span class="r-title">{e.title}</span>
      <button type="button" class="r-icon r-aa" id="r-aa" aria-label="Text settings" aria-haspopup="dialog" hidden>Aa</button>
      {multi && (
        <button type="button" class="r-icon" id="r-toc" aria-label={`${unit}s`} aria-haspopup="dialog" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
        </button>
      )}
    </div>

    <article class="r-page" id="r-page" lang={e.language || undefined}>
      {multi && (
        <header class="r-book">
          <h1>{e.title}</h1>
          <p class="r-by">by {authorLabel(e)}</p>
          <p class="r-meta">{chapters.length} {unit.toLowerCase()}s · {formatNumber(words)} words · about {readTime}</p>
        </header>
      )}
      {chapters.map((c: any, i: number) => (
        <section class="r-ch" id={`ch-${i + 1}`} data-words={c.words} aria-labelledby={`ch-${i + 1}-h`}>
          {multi ? (
            <>
              <p class="r-chap">{unit} {i + 1} of {chapters.length}</p>
              <h2 id={`ch-${i + 1}-h`}>{c.title || `${unit} ${i + 1}`}</h2>
            </>
          ) : (
            <>
              <h1 id={`ch-${i + 1}-h`}>{e.title}</h1>
              <p class="r-by">by {authorLabel(e)} · {formatNumber(words)} words · about {readTime}</p>
            </>
          )}
          <div class="r-text">
            {c.blocks.map((b: any) => {
              const Tag = tagFor(b.level);
              return <Tag>{b.text}</Tag>;
            })}
          </div>
        </section>
      ))}
      <p class="r-end"><a href={itemHref}>Back to {e.title}</a></p>
    </article>

    <div class="r-foot" id="r-foot" hidden>
      <div class="r-resume" id="r-resume" role="region" aria-label="Continue reading" hidden>
        <button type="button" class="r-resume-go" id="r-resume-go">Continue where you left off <span id="r-resume-where"></span></button>
        <button type="button" class="r-icon r-resume-x" id="r-resume-x" aria-label="Dismiss">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="r-track" aria-hidden="true"><i id="r-fill"></i></div>
      <div class="r-status"><span id="r-where"></span><span id="r-left"></span></div>
    </div>
  </div>

  <dialog class="r-sheet r-settings" id="r-settings" aria-labelledby="r-settings-h">
    <div class="r-grab" aria-hidden="true"></div>
    <h2 id="r-settings-h" class="visually-hidden">Text settings</h2>
    <div class="r-row">
      <span id="r-l-size">Text size</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-size">
        <button type="button" data-size="-1" aria-label="Smaller text">A−</button>
        <output id="r-size" aria-live="polite">18</output>
        <button type="button" data-size="1" aria-label="Bigger text">A+</button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-theme">Theme</span>
      <div class="r-swatches" role="group" aria-labelledby="r-l-theme">
        <button type="button" class="r-sw r-sw-light" data-theme-pick="light" aria-label="Light" aria-pressed="false"></button>
        <button type="button" class="r-sw r-sw-sepia" data-theme-pick="sepia" aria-label="Sepia" aria-pressed="false"></button>
        <button type="button" class="r-sw r-sw-dark" data-theme-pick="dark" aria-label="Dark" aria-pressed="false"></button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-lh">Line spacing</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-lh">
        <button type="button" data-lh="tight" aria-pressed="false">Tight</button>
        <button type="button" data-lh="normal" aria-pressed="false">Normal</button>
        <button type="button" data-lh="loose" aria-pressed="false">Loose</button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-w">Width</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-w">
        <button type="button" data-w="narrow" aria-pressed="false">Narrow</button>
        <button type="button" data-w="medium" aria-pressed="false">Medium</button>
        <button type="button" data-w="wide" aria-pressed="false">Wide</button>
      </div>
    </div>
    <button type="button" class="secondary r-done" data-close>Done</button>
  </dialog>

  {multi && (
    <dialog class="r-sheet r-chapters" id="r-chapters" aria-labelledby="r-chapters-h">
      <div class="r-grab" aria-hidden="true"></div>
      <div class="r-sheet-head">
        <h2 id="r-chapters-h">{unit}s</h2>
        <button type="button" class="r-icon" data-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <ol class="r-toc">
        {chapters.map((c: any, i: number) => (
          <li>
            <a href={`#ch-${i + 1}`} data-ch={i + 1}>
              <span class="r-toc-n">{i + 1}</span>
              <span class="r-toc-t">{c.title || `${unit} ${i + 1}`}</span>
              <span class="r-toc-m">{Math.max(1, Math.round(c.words / 230))} min</span>
            </a>
          </li>
        ))}
      </ol>
    </dialog>
  )}
</Base>

<script>
  import { initReader } from '../../../scripts/reader.js';
  initReader();
</script>

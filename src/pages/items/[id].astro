---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { loadArchive, hasReader, textOnly, textPreview, formatBytes, formatNumber, formatDate, readableDates, authorLabel, readerUnit, LIBRARIES } from '../../lib/archive.mjs';
import { ARCHIVE_REPO_URL } from '../../lib/config.mjs';

export function getStaticPaths() {
  const { entries, characters, series, topics } = loadArchive();
  const byChar = new Map(characters.map((c) => [c.id, c.entries]));
  const bySeries = new Map(series.map((s) => [s.id, s.entries]));
  const byTopic = new Map(topics.filter((t) => !t.help).map((t) => [t.id, t.entries]));
  // Related: entries sharing the most characters, then the same series or topic; longer docs first. Max 5.
  const related = (e: any) => {
    const score = new Map<any, number>();
    for (const c of e.characters) for (const x of byChar.get(c.id) || []) score.set(x, (score.get(x) || 0) + 10);
    for (const s of e.series) for (const x of bySeries.get(s.id) || []) score.set(x, (score.get(x) || 0) + 1);
    for (const t of e.topics) for (const x of byTopic.get(t.id) || []) score.set(x, (score.get(x) || 0) + 1);
    score.delete(e);
    return [...score.entries()].sort((a, b) => b[1] - a[1] || b[0].words - a[0].words).slice(0, 5).map(([x]) => x);
  };
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, related: related(entry) } }));
}

const { entry: e, related } = Astro.props as { entry: any; related: any[] };
const readMinutes = Math.round(e.words / 230);
const readTime =
  readMinutes < 1 ? null : readMinutes < 60 ? `${readMinutes} min` : `${readMinutes < 600 ? Math.round(readMinutes / 6) / 10 : Math.round(readMinutes / 60)} h`;
// Stats under the byline: up to four short columns (value on top, label below), only what exists.
const single = e.parts.length === 1 ? e.parts[0] : null;
const dates = e.parts.map((p: any) => p.date).filter(Boolean).sort();
const savedDate = single ? single.date : dates[dates.length - 1];
const savedLabel = single?.fromSnapshot ? 'snapshot' : !single || single.status === 'complete' || single.status === 'partial' ? 'saved' : 'tried';
const stats = [
  e.parts.length > 1 && { v: formatNumber(e.parts.length), l: readerUnit(e) === 'Volume' ? 'volumes' : 'parts' },
  e.pages > 0 && { v: formatNumber(e.pages), l: 'pages' },
  e.words > 0 && { v: formatNumber(e.words), l: 'words' },
  readTime && { v: readTime, l: 'read' },
  savedDate && { v: formatDate(savedDate), l: savedLabel, iso: savedDate },
].filter(Boolean);
if (stats.length > 4) stats.splice(stats.findIndex((s: any) => s.l === 'pages'), 1);
const statusLabel = single && single.status !== 'complete' && single.status !== 'export-blocked' ? single : null;
const topic = e.topics[0] || null;
const sortTopic = e.topics.find((t: any) => t.id === 'series-unknown' || t.id === 'needs-sorting') || null;
const relatedTitle = e.characters[0]
  ? `More about ${e.characters[0].name}`
  : e.series[0]
    ? `More from ${e.series[0].name}`
    : topic && !sortTopic
      ? `More in ${topic.name}`
      : 'More like this';
const relatedMore = e.characters[0]
  ? { href: `/characters/${e.characters[0].id}/`, label: `All docs about ${e.characters[0].name}` }
  : e.series[0]
    ? { href: `/series/${e.series[0].id}/`, label: `All ${e.series[0].name} docs` }
    : topic && !sortTopic
      ? { href: `/topics/${topic.id}/`, label: `All of ${topic.name}` }
      : null;
const preview = textPreview(e, 1500);
const multi = e.parts.length > 1;
// Every entry with text has the reader. For text-only entries (no PDF/DOCX to open) it is the main way to read;
// for the rest the PDF stays the main button and "Read here" is a quieter second one.
const readHref = hasReader(e) ? `/items/${e.id}/read/` : null;
const readOnly = readHref && textOnly(e);
// Multi-part entries: a Read button per part (the reader's chapter n is the n-th part with text). Up to 4 sit side
// by side at the top ("Read volume 1", "Read volume 2"); with more, one "Read from the start" and a Read button in
// each part's fold.
const textParts = e.parts.filter((p: any) => p.textPath);
const partRead = (p: any) => {
  const k = textParts.indexOf(p);
  return readHref && k >= 0 ? (k === 0 ? readHref : `${readHref}#ch-${k + 1}`) : null;
};
const partUnit = readerUnit(e).toLowerCase();
const readChoices = readHref && multi && textParts.length > 1 && textParts.length <= 4;
// The main (filled) file button of a part: its PDF, else its first other file.
const mainFile = (p: any) => p.files.find((f: any) => f.format === 'pdf' && !p.images.includes(f)) || p.files.find((f: any) => !p.images.includes(f));
const completion = { finished: 'Finished', 'in-progress': 'In progress', unknown: null }[e.completion as string];
// The Submit form, with this entry filled in (no account needed). Public GitHub issues are linked from there.
const correctionUrl = `/submit/?fix=${e.id}`;
// What couldn't be saved, as one sentence: formats with the same reason are named once.
const andList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const missingSentence = (p: any) => {
  const byReason = new Map<string, string[]>();
  for (const [fmt, why] of p.missing as [string, string][]) byReason.set(why, [...(byReason.get(why) || []), fmt]);
  if (byReason.size === 1 && byReason.has('the owner turned off downloads')) {
    return p.textPath ? 'The owner turned off downloads.' : 'The owner turned off downloads, so no copy could be saved.';
  }
  return `Not saved: ${[...byReason].map(([why, fmts]) => (why ? `${andList(fmts)} (${why})` : andList(fmts))).join('; ')}.`;
};
const checkNames: Record<string, string> = { authors: 'author', series: 'series', characters: 'characters', tags: 'tags', title: 'title', language: 'language' };
// Other titles, leaving out ones that differ from the title only in quote marks, case or spacing.
const same = (t: string) => t.toLowerCase().replace(/[‘’“”'"`\s]/g, '');
const altTitles = e.altTitles.filter((t: string, i: number, all: string[]) => same(t) !== same(e.title) && all.findIndex((x) => same(x) === same(t)) === i);
const desc = `${e.categoryName} by ${authorLabel(e)}${e.series.length ? ` about ${e.series.map((s: any) => s.name).join(', ')}` : ''}. Archived from r/IntelligenceScaling.`;
// Structured data for search engines (schema.org). "<" is escaped so archive text can't close the script tag.
const pageUrl = new URL(`/items/${e.id}/`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': e.category === 'story' ? 'ShortStory' : 'CreativeWork',
  name: e.title,
  ...(altTitles.length ? { alternateName: altTitles.slice(0, 5) } : {}),
  url: pageUrl,
  description: desc,
  ...(e.authors.length
    ? { author: e.authors.map((a: any) => ({ '@type': 'Person', name: a.name, ...(a.reddit ? { url: `https://www.reddit.com/user/${a.reddit}/` } : {}) })) }
    : {}),
  ...(e.series.length || e.characters.length
    ? { about: [...e.series.map((s: any) => ({ '@type': 'CreativeWorkSeries', name: s.name })), ...e.characters.slice(0, 10).map((c: any) => ({ '@type': 'Thing', name: c.name }))] }
    : {}),
  ...(e.words ? { wordCount: e.words } : {}),
  ...(e.language ? { inLanguage: e.language } : {}),
  // The date it was archived, not when the doc was written (that isn't known).
  ...(/^\d{4}-\d{2}-\d{2}$/.test(e.added) ? { sdDatePublished: e.added } : {}),
  isPartOf: { '@type': 'WebSite', name: 'Intelligence Scaling Archive', url: new URL('/', Astro.site).href },
  ...(e.originalUrl ? { sameAs: e.originalUrl } : {}),
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
---
<Base title={e.title} description={desc} ogType="article">
  <script type="application/ld+json" slot="head" is:inline set:html={ldJson} />
  {(e.series[0] || topic) && (
    <nav class="crumbs" aria-label="Breadcrumb">
      {e.series[0] ? <a href={`/series/${e.series[0].id}/`}>{e.series[0].name}</a> : <a href={`/topics/${topic.id}/`}>{topic.name}</a>}
    </nav>
  )}

  <header class="item-head">
    <h1>{e.title}</h1>
    <p class="byline">
      {e.authors.length ? (
        <>by {e.authors.map((a: any, i: number) => <>{i > 0 && ', '}<a href={`/authors/${a.key}/`}>{a.name}</a></>)}</>
      ) : (
        <>
          <span class="muted">Unknown author.</span>
          {e.originalUrl && !e.parts.some((p: any) => p.url === e.originalUrl) && <> See the <a href={e.originalUrl} rel="noopener nofollow ugc">{e.hasRedditSource || e.links.some((l: any) => l.type === 'reddit-post') ? 'original post' : 'original'}</a>.</>}
          {' '}<a href={correctionUrl} rel="noopener">Know who made it?</a>
        </>
      )}
    </p>
    {stats.length > 0 && (
      <dl class="stats-row">
        {stats.map((s: any) => (
          <div>
            <dt>{s.l}</dt>
            <dd>{s.iso ? <time datetime={s.iso}>{s.v}</time> : s.v}</dd>
          </div>
        ))}
      </dl>
    )}
    {statusLabel && <p class="item-status"><span class={`badge ${statusLabel.tone}`}>{statusLabel.statusLabel}</span></p>}
  </header>

  <div class="item-grid">
    <div>
      {readHref && multi && (
        <div class={`downloads read-cta${readChoices ? ' read-choices' : ''}`}>
          {readChoices
            ? textParts.map((p: any, k: number) => (
                <a class={`button${readOnly ? '' : ' secondary'}`} href={partRead(p)}>Read {partUnit} {k + 1}</a>
              ))
            : <a class={`button${readOnly ? '' : ' secondary'}`} href={readHref}>Read {e.category === 'story' ? 'the story' : 'it'} from the start</a>}
        </div>
      )}
      {multi && <h2>{partUnit === 'volume' ? 'Volumes' : 'Parts'}</h2>}
      {e.parts.map((p: any) => {
        const Part = multi ? 'details' : 'section';
        return (
        <Part class={multi ? 'part fold' : 'files'} aria-label={multi ? undefined : 'Files'}>
          {multi ? (
            <summary>
              <h3>
                <span>{p.title || `Part ${p.n}`}</span>
                {p.status !== 'complete' && p.status !== 'export-blocked' && <span class={`badge ${p.tone}`}>{p.statusLabel}</span>}
                {p.words !== null && <span class="part-words">{formatNumber(p.words)} words</span>}
              </h3>
            </summary>
          ) : null}
          {p.images.length > 0 && (
            <div class="post-images">
              {p.images.map((f: any, k: number) => (
                <a href={f.href} rel="noopener">
                  <img src={f.href} loading="lazy" decoding="async" alt={`Image ${k + 1} of ${p.images.length} from ${multi ? (p.title || `part ${p.n}`) : 'the post'}`} />
                </a>
              ))}
            </div>
          )}
          {(p.textHref || p.files.some((f: any) => !p.images.includes(f))) && (
            <div class="downloads">
              {readOnly && !multi && <a class="button" href={readHref}>Read</a>}
              {p.textHref && (
                <a class={`button${readHref ? ' secondary' : ''}`} href={p.textHref} rel="noopener">Download text <span class="size">TXT</span></a>
              )}
              {p.files.filter((f: any) => !p.images.includes(f)).map((f: any) =>
                f.href ? (
                  <a class={`button${f === mainFile(p) ? '' : ' secondary'}`} href={f.href} rel="noopener">
                    {f.format === 'pdf' ? 'Open PDF' : `Download ${f.formatName}`} <span class="size">{formatBytes(f.bytes)}</span>
                  </a>
                ) : (
                  <span class="button" aria-disabled="true" title="Downloads are not available yet">
                    {f.formatName} <span class="size">{formatBytes(f.bytes)}</span>
                  </span>
                ),
              )}
              {readHref && !readOnly && !multi && <a class="button secondary" href={readHref}>Read here</a>}
              {multi && partRead(p) && <a class="button secondary" href={partRead(p)}>Read here</a>}
            </div>
          )}
          {p.files.length > 0 && p.files.some((f: any) => !f.href) && (
            <p class="small muted">Downloads are coming soon. The files are saved, but not online yet.</p>
          )}
          {p.status === 'export-blocked' ? (
            <p class="small muted">
              The owner turned off downloads for this {p.sourceLabel}, so no copy could be saved yet.
              {p.url && ' Open the original while it is still online.'}
            </p>
          ) : p.missing.length > 0 && (
            <p class="small muted">{missingSentence(p)}</p>
          )}
          {p.url && (
            <a class="original-link" href={p.url} rel="noopener nofollow ugc">Open the original {p.sourceLabel} <span aria-hidden="true">↗</span></a>
          )}
        </Part>
        );
      })}

      {!preview && e.status === 'complete' && e.parts.some((p: any) => p.files.length > 0) && (
        <p class="small muted mt">This doc is mostly images, so there is no text preview and full-text search can't look inside it. Open the PDF to read it.</p>
      )}

      {preview && (
        <section class="preview" aria-labelledby="h-preview">
          <h2 id="h-preview">{multi ? 'Start of the story' : 'Start of the text'}</h2>
          <div class="preview-text">{preview}</div>
          <p class="small muted">
            {e.parts.some((p: any) => p.files.some((f: any) => f.format === 'pdf' || f.format === 'docx'))
              ? 'The first lines of the plain-text copy. Formatting and images are only in the PDF/DOCX.'
              : 'The first lines of the saved text.'}
          </p>
          {readHref && <p class="read-more"><a class="button secondary" href={readHref}>Read the full text</a></p>}
        </section>
      )}

      {e.foundIn.length > 0 && (
        <details class="fold">
          <summary><h2>Where it was listed</h2></summary>
          <ul class="found-in">
            {e.foundIn.map((f: any) => (
              <li>
                <a href={f.libraryUrl} rel="noopener">{f.libraryName}</a>
                <span class="muted small"> by {LIBRARIES[f.library].by.map((u: string) => `u/${u}`).join(' & ')}</span>
                <div class="small">
                  {f.section && <>Section: {f.section}</>}
                  {f.character && <> · Character: {f.character}</>}
                  {f.linkText && f.linkText !== e.title && <> · Listed as <q>{f.linkText}</q></>}
                  {f.note && <> · {readableDates(f.note)}</>}
                </div>
              </li>
            ))}
          </ul>
        </details>
      )}

      {e.links.length > 0 && (
        <details class="fold">
          <summary><h2>Links</h2></summary>
          <ul class="link-list">
            {e.links.map((l: any) => (
              <li><a href={l.url} rel="noopener nofollow ugc">{l.label}</a>{l.note && <span class="muted"> · {readableDates(l.note)}</span>}</li>
            ))}
          </ul>
        </details>
      )}

      {e.notes && (
        <>
          <h2>Notes</h2>
          <p class="prose">{readableDates(e.notes)}</p>
        </>
      )}

      {related.length > 0 && (
        <details class="fold">
          <summary><h2>{relatedTitle}</h2></summary>
          <EntryList entries={related} sort="none" />
          {relatedMore && <p class="more-link"><a href={relatedMore.href}>{relatedMore.label}</a></p>}
        </details>
      )}
    </div>

    <aside>
      <details class="fold aside-fold">
      <summary><h2>Details</h2></summary>
      <dl class="facts">
        <dt>Author</dt>
        <dd>
          {e.authors.length ? (
            <ul>
              {e.authors.map((a: any) => (
                <li>
                  <a href={`/authors/${a.key}/`}>{a.name}</a>
                  {a.reddit && <> <a class="small" href={`https://www.reddit.com/user/${a.reddit}/`} rel="noopener nofollow">u/{a.reddit}</a></>}
                </li>
              ))}
            </ul>
          ) : (
            <span class="muted">Unknown</span>
          )}
        </dd>
        {e.series.length > 0 && (
          <>
            <dt>Series</dt>
            <dd><ul>{e.series.map((s: any) => <li><a href={`/series/${s.id}/`}>{s.name}</a></li>)}</ul></dd>
          </>
        )}
        {e.topics.length > 0 && (
          <>
            <dt>{e.topics.length > 1 ? 'Topics' : 'Topic'}</dt>
            <dd><ul>{e.topics.map((t: any) => <li><a href={`/topics/${t.id}/`}>{t.name}</a></li>)}</ul></dd>
          </>
        )}
        {e.characters.length > 0 && (
          <>
            <dt>{e.characters.length > 1 ? 'Characters' : 'Character'}</dt>
            <dd><ul>{e.characters.map((c: any) => <li><a href={`/characters/${c.id}/`}>{c.name}</a></li>)}</ul></dd>
          </>
        )}
        {e.variant && (<><dt>Version</dt><dd>{e.variant}</dd></>)}
        {altTitles.length > 0 && (<><dt>Also listed as</dt><dd><ul>{altTitles.map((t: string) => <li>{t}</li>)}</ul></dd></>)}
        {e.tags.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd><ul class="chips">{e.tags.map((t: string) => <li><a class="chip" href={`/tags/${t}/`}>{t}</a></li>)}</ul></dd>
          </>
        )}
        <dt>Language</dt>
        <dd>{e.languageName}</dd>
        {completion && (<><dt>Status</dt><dd>{completion}</dd></>)}
        {e.words > 0 && (<><dt>Length</dt><dd>{formatNumber(e.words)} words{e.pages > 0 && `, ${formatNumber(e.pages)} pages`}</dd></>)}
        <dt>Source</dt>
        <dd><a href={`${ARCHIVE_REPO_URL}/tree/main/${e.repoPath}`} rel="noopener">Metadata on GitHub</a></dd>
      </dl>
      </details>
      <details class="fold aside-fold">
        <summary><h2>Corrections and removal</h2></summary>
        <div>
          {sortTopic && <p class="small">Not sorted yet. <a href={correctionUrl} rel="noopener">Help sort it</a>.</p>}
          {e.review.status === 'auto' && (
            <p class="small">
              This entry was filled in automatically
              {e.review.check.length > 0 && <>; the {e.review.check.map((c: string) => checkNames[c] || c).join(', ')} may be wrong</>}.
            </p>
          )}
          <p class="small"><a href={correctionUrl} rel="noopener">Suggest a correction</a></p>
        </div>
        <p class="small muted mt">
          Are you the author? You can <a href={`/removal/?item=${e.id}`}>ask for this to be removed</a> or credited differently.
        </p>
      </details>
    </aside>
  </div>
</Base>

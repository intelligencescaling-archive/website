---
import Base from '../../layouts/Base.astro';
import DocList from '../../components/DocList.astro';
import Icon from '../../components/Icon.astro';
import Blk from '../../components/Blk.astro';
import Fold from '../../components/Fold.astro';
import AccountFlag from '../../components/AccountFlag.astro';
import SaveButton from '../../components/SaveButton.astro';
import { shortNum, kindOf, contactHint, previewBlocks } from '../../lib/ui.mjs';
import { mdPreview } from '../../lib/reddit-md.mjs';
import { loadArchive, redditAccount, hasReader, textOnly, textPreview, markdownStart, formatBytes, formatNumber, formatDate, readableDates, bylineText, sharerName, readerUnit, LIBRARIES } from '../../lib/archive.mjs';
import { ARCHIVE_REPO_URL } from '../../lib/config.mjs';

export function getStaticPaths() {
  const { entries, characters, series, topics } = loadArchive();
  const byChar = new Map(characters.map((c) => [c.id, c.entries]));
  const bySeries = new Map(series.map((s) => [s.id, s.entries]));
  const byTopic = new Map(topics.filter((t) => !t.help).map((t) => [t.id, t.entries]));
  // Related: entries sharing the most characters, then the same series or topic; longer docs first. Max 5.
  const related = (e: any) => {
    const score = new Map<any, number>();
    for (const c of e.characters) for (const x of byChar.get(c.id) || []) score.set(x, (score.get(x) || 0) + 10);
    for (const s of e.series) for (const x of bySeries.get(s.id) || []) score.set(x, (score.get(x) || 0) + 1);
    for (const t of e.topics) for (const x of byTopic.get(t.id) || []) score.set(x, (score.get(x) || 0) + 1);
    score.delete(e);
    return [...score.entries()].sort((a, b) => b[1] - a[1] || b[0].words - a[0].words).slice(0, 5).map(([x]) => x);
  };
  const charSeries = new Map(characters.map((c) => [c.id, c.seriesName]));
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, related: related(entry), charSeries } }));
}

const { entry: e, related, charSeries } = Astro.props as { entry: any; related: any[]; charSeries: Map<string, string | null> };
const readMinutes = Math.round(e.words / 230);
const readTime =
  readMinutes < 1 ? null : readMinutes < 60 ? `${readMinutes} min` : `${readMinutes < 600 ? Math.round(readMinutes / 6) / 10 : Math.round(readMinutes / 60)} h`;
// Numbers for the stat line under the byline, only what exists.
const single = e.parts.length === 1 ? e.parts[0] : null;
const dates = e.parts.map((p: any) => p.date).filter(Boolean).sort();
const savedDate = single ? single.date : dates[dates.length - 1];
const savedLabel = single?.fromSnapshot ? 'snapshot' : !single || single.status === 'complete' || single.status === 'partial' ? 'saved' : 'tried';
const stats = [
  e.parts.length > 1 && { v: formatNumber(e.parts.length), l: readerUnit(e) === 'Volume' ? 'volumes' : 'parts' },
  e.pages > 0 && { v: formatNumber(e.pages), l: 'pages' },
  e.words > 0 && { v: formatNumber(e.words), l: 'words' },
  readTime && { v: readTime, l: 'read' },
].filter(Boolean);
// One quiet line under the byline (mockup 2, option A): "93 pages · 52,067 words · about 3.8 h".
const statLine = stats.map((s: any) => (s.l === 'read' ? `about ${s.v}` : `${s.v} ${s.l}`)).join(' · ');
// The status badge under the header, unless a meta tag chip already says it ("Text only", "Original gone").
const saidByChip = (p: any) => (p.recovered && e.tags.includes('text-only')) || ((p.status === 'dead' || p.status === 'private' || p.fromSnapshot) && e.tags.includes('original-gone'));
const statusLabel = single && single.status !== 'complete' && single.status !== 'export-blocked' && !saidByChip(single) ? single : null;
// Breadcrumb: the first series; without a series, the doc's main tag (its first non-meta tag), else the help list
// it is in ("Needs sorting"). Topics were folded into tags.
const crumbTag = !e.series.length ? e.tagList.find((t: any) => t.group !== 'meta') || null : null;
// Chips under the byline: characters, any series after the first (the first is the breadcrumb), then the tags; the
// tag that is already the breadcrumb is left out.
const sortTopic = e.topics.find((t: any) => t.id === 'series-unknown' || t.id === 'needs-sorting') || null;
const relatedMore = e.characters[0]
  ? { href: `/characters/${e.characters[0].id}/`, label: `All docs about ${e.characters[0].name}` }
  : e.series[0]
    ? { href: `/series/${e.series[0].id}/`, label: `All ${e.series[0].name} docs` }
    : crumbTag
      ? { href: `/tags/${crumbTag.id}/`, label: `All ${crumbTag.name} docs` }
      : null;
// A Reddit post's preview is its markdown, rendered (src/lib/reddit-md.mjs); its first line is the post title.
const mdStart = markdownStart(e);
const makerNames = e.authors.map((a: any) => a.name);
const mdPv = mdStart ? mdPreview(mdStart, previewBlocks(mdStart.split('\n')[0], e.title, makerNames).slice(0, 1)) : null;
const previewRaw = mdPv ? '' : textPreview(e, 3000);
const preview = mdPv ? [] : previewBlocks(previewRaw, e.title, makerNames);
const previewCut = mdPv ? mdPv.cut : previewRaw.endsWith(' …');
const multi = e.parts.length > 1;
// Every entry with text has the reader. For text-only entries (no PDF/DOCX to open) it is the main way to read;
// for the rest the PDF stays the main button and "Read here" is a quieter second one.
const readHref = hasReader(e) ? `/items/${e.id}/read/` : null;
const readOnly = readHref && textOnly(e);
// Multi-part entries: a Read button per part (the reader's chapter n is the n-th part with text). Up to 4 sit side
// by side at the top ("Read volume 1", "Read volume 2"); with more, one "Read from the start" and a Read button in
// each part's fold.
const textParts = e.parts.filter((p: any) => p.textPath);
const partRead = (p: any) => {
  const k = textParts.indexOf(p);
  return readHref && k >= 0 ? (k === 0 ? readHref : `${readHref}#ch-${k + 1}`) : null;
};
const partUnit = readerUnit(e).toLowerCase();
// The main (filled) file button of a part: its PDF, else its first other file.
const mainFile = (p: any) => p.files.find((f: any) => f.format === 'pdf' && !p.images.includes(f)) || p.files.find((f: any) => !p.images.includes(f));
const completion = { finished: 'Finished', 'in-progress': 'In progress', unknown: null }[e.completion as string];
// The Submit form, with this entry filled in (no account needed). Public GitHub issues are linked from there.
const correctionUrl = `/submit/?fix=${e.id}`;
// What couldn't be saved, as one sentence: formats with the same reason are named once.
const andList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const missingSentence = (p: any) => {
  const byReason = new Map<string, string[]>();
  for (const [fmt, why] of p.missing as [string, string][]) byReason.set(why, [...(byReason.get(why) || []), fmt]);
  if (byReason.size === 1 && byReason.has('the owner turned off downloads')) {
    return p.textPath ? 'The owner turned off downloads.' : 'The owner turned off downloads, so no copy could be saved.';
  }
  return `Not saved: ${[...byReason].map(([why, fmts]) => (why ? `${andList(fmts)} (${why})` : andList(fmts))).join('; ')}.`;
};
const checkNames: Record<string, string> = { authors: 'author', series: 'series', characters: 'characters', tags: 'tags', title: 'title', language: 'language' };
// Other titles, leaving out ones that differ from the title only in quote marks, case or spacing.
const same = (t: string) => t.toLowerCase().replace(/[‘’“”'"`\s]/g, '');
const altTitles = e.altTitles.filter((t: string, i: number, all: string[]) => same(t) !== same(e.title) && all.findIndex((x) => same(x) === same(t)) === i);
const desc = `${e.categoryName} ${bylineText(e)}${e.series.length ? ` about ${e.series.map((s: any) => s.name).join(', ')}` : ''}. Archived from r/IntelligenceScaling.`;
// Structured data for search engines (schema.org). "<" is escaped so archive text can't close the script tag.
const pageUrl = new URL(`/items/${e.id}/`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': e.category === 'story' ? 'ShortStory' : 'CreativeWork',
  name: e.title,
  ...(altTitles.length ? { alternateName: altTitles.slice(0, 5) } : {}),
  url: pageUrl,
  description: desc,
  ...(e.authors.length
    ? { author: e.authors.map((a: any) => ({ '@type': 'Person', name: a.name, ...(a.reddit && !redditAccount(a.reddit) ? { url: `https://www.reddit.com/user/${a.reddit}/` } : {}) })) }
    : {}),
  ...(e.series.length || e.characters.length
    ? { about: [...e.series.map((s: any) => ({ '@type': 'CreativeWorkSeries', name: s.name })), ...e.characters.slice(0, 10).map((c: any) => ({ '@type': 'Thing', name: c.name }))] }
    : {}),
  ...(e.words ? { wordCount: e.words } : {}),
  ...(e.language ? { inLanguage: e.language } : {}),
  // The date it was archived, not when the doc was written (that isn't known).
  ...(/^\d{4}-\d{2}-\d{2}$/.test(e.added) ? { sdDatePublished: e.added } : {}),
  isPartOf: { '@type': 'WebSite', name: 'Intelligence Scaling Archive', url: new URL('/', Astro.site).href },
  ...(e.originalUrl ? { sameAs: e.originalUrl } : {}),
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
// ---- Calm layout (rules.md 3.4) ----
const kind = kindOf(e);
// One meta line: maker(s) · kind · size. Status words go to Details.
const metaRest = [kind, e.words > 0 ? `${shortNum(e.words)} words` : ''].filter(Boolean);
// Subject rows: characters (with their series), then series that no character row names.
const subjRows = [
  ...e.characters.map((c: any) => ({ href: `/characters/${c.id}/`, name: c.name, sub: charSeries.get(c.id) || '', icon: 'char' })),
  ...e.series
    .filter((s: any) => !e.characters.some((c: any) => charSeries.get(c.id) === s.name))
    .map((s: any) => ({ href: `/series/${s.id}/`, name: s.name, sub: '', icon: 'series' })),
];
const SUBJ_CAP = 3;
const subjShow = subjRows.length <= SUBJ_CAP + 1 ? subjRows.length : SUBJ_CAP;
// Buttons: one filled (Open PDF, or Read for text-only docs), the other formats and the original as text buttons.
const shortSource = (p: any) => String(p.sourceLabel || 'Original').replace(/ \(.*\)$/, '');
const fileLabel = (f: any) => (f.format === 'pdf' ? 'Open PDF' : `Open ${f.formatName}`);
const otherFiles = (p: any) => p.files.filter((f: any) => !p.images.includes(f) && f !== mainFile(p));
const notOnline = e.parts.some((p: any) => p.files.some((f: any) => !f.href));
const sizes = e.parts.flatMap((p: any) => p.files.filter((f: any) => !p.images.includes(f) && f.bytes)).map((f: any) => `${f.formatName} ${formatBytes(f.bytes)}`);
const originalPost = e.originalUrl && !e.parts.some((p: any) => p.url === e.originalUrl) ? e.originalUrl : null;
const readLabel = e.pages > 1 ? `Read all ${formatNumber(e.pages)} pages` : 'Read the full text';
const relatedKnown = e.characters[0]?.id || e.series[0]?.id;
---
<Base title={e.title} description={desc} ogType="article">
  <script type="application/ld+json" slot="head" is:inline set:html={ldJson} />
  <div class="cols">
    <div class="main">
      <h1>{e.title}</h1>
      <p class="m1">
        {e.authors.length ? (
          e.authors.map((a: any, i: number) => <>{i > 0 && ', '}{contactHint(a) ? (
            <a class="il" href={`/authors/${a.key}/#contact`}>{a.name}<span class="sx"> ({contactHint(a)})</span></a>
          ) : <a class="il" href={`/authors/${a.key}/`}>{a.name}</a>}</>)
        ) : e.sharedBy.length ? (
          <>shared by {e.sharedBy.map((x: any, i: number) => <>{i > 0 && ', '}<a class="il" href={`/authors/${x.key}/`}>{sharerName(x)}</a>{x.reddit && redditAccount(x.reddit) && <> <AccountFlag acct={redditAccount(x.reddit)} /></>}</>)}</>
        ) : 'Unknown author'}
        {metaRest.map((m) => <> · {m}</>)}
      </p>

      {subjRows.length > 0 && (
        <div class="subj">
          <ul class="ls" data-list data-cap={SUBJ_CAP}>
            {subjRows.map((r, i) => (
              <li class={i >= subjShow ? 'cut' : undefined}>
                <a class="r1" href={r.href}><Icon name={r.icon} class="g" /><span class="nm">{r.name}{r.sub && <span class="sx"> · {r.sub}</span>}</span><Icon name="go" class="chev" /></a>
              </li>
            ))}
          </ul>
          {subjRows.length > subjShow && <button class="more js-only" type="button" data-expand data-noun={e.characters.length ? 'characters' : 'series'}><span class="lbl">All {subjRows.length} {e.characters.length ? 'characters' : 'series'}</span><Icon name="down" class="chev" /></button>}
          <div class="end" hidden={subjRows.length > subjShow}></div>
        </div>
      )}

      {!multi && single && (
        <>
          <div class="acts">
            {readOnly && <a class="btn" href={readHref}>Read</a>}
            {!readOnly && mainFile(single)?.href && <a class="btn" href={mainFile(single).href} rel="noopener">{fileLabel(mainFile(single))}</a>}
            {otherFiles(single).filter((f: any) => f.href).map((f: any) => <a class="tbtn" href={f.href} rel="noopener">{f.formatName}</a>)}
            {single.textHref && <a class="tbtn" href={single.textHref} rel="noopener">TXT</a>}
            {single.url && <a class="tbtn" href={single.url} rel="noopener nofollow ugc">{shortSource(single)}</a>}
            {originalPost && <a class="tbtn" href={originalPost} rel="noopener nofollow ugc">{e.hasRedditSource || e.links.some((l: any) => l.type === 'reddit-post') ? 'Reddit post' : 'Original'}</a>}
            <SaveButton entry={e} />
          </div>
          {single.status === 'export-blocked' ? (
            <p class="note-l">The owner turned off downloads for this {single.sourceLabel}, so no copy could be saved yet.{single.url && ' Open the original while it is still online.'}</p>
          ) : single.missing.length > 0 && <p class="note-l">{missingSentence(single)}</p>}
          {single.images.length > 0 && (
            <div class="imgs">
              {single.images.map((f: any, k: number) => (
                <a href={f.href} rel="noopener"><img src={f.href} loading="lazy" decoding="async" alt={`Image ${k + 1} of ${single.images.length} from the post`} /></a>
              ))}
            </div>
          )}
        </>
      )}

      {multi && (
        <>
          <div class="acts">
            {readHref && <a class="btn" href={readHref}>Read from the start</a>}
            {originalPost && <a class="tbtn" href={originalPost} rel="noopener nofollow ugc">Original</a>}
            <SaveButton entry={e} />
          </div>
          <section class="parts">
            <div class="sh"><h2 class="sl">{partUnit === 'volume' ? 'Volumes' : 'Parts'}</h2><span class="sl">Words</span></div>
            {e.parts.map((p: any) => (
              <Fold label={p.title || `Part ${p.n}`} count={p.words ? shortNum(p.words) : null}>
                <div class="part-body">
                  <div class="acts">
                    {partRead(p) && <a class="tbtn" href={partRead(p)}>Read</a>}
                    {p.files.filter((f: any) => !p.images.includes(f) && f.href).map((f: any) => <a class="tbtn" href={f.href} rel="noopener">{f.formatName}</a>)}
                    {p.textHref && <a class="tbtn" href={p.textHref} rel="noopener">TXT</a>}
                    {p.url && <a class="tbtn" href={p.url} rel="noopener nofollow ugc">{shortSource(p)}</a>}
                  </div>
                  {p.status !== 'complete' && p.status !== 'export-blocked' && <p class="note-l">{p.statusLabel}</p>}
                  {p.status === 'export-blocked' ? (
                    <p class="note-l">The owner turned off downloads for this {p.sourceLabel}, so no copy could be saved yet.</p>
                  ) : p.missing.length > 0 && <p class="note-l">{missingSentence(p)}</p>}
                  {p.images.length > 0 && (
                    <div class="imgs">
                      {p.images.map((f: any, k: number) => (
                        <a href={f.href} rel="noopener"><img src={f.href} loading="lazy" decoding="async" alt={`Image ${k + 1} of ${p.images.length} from ${p.title || `part ${p.n}`}`} /></a>
                      ))}
                    </div>
                  )}
                </div>
              </Fold>
            ))}
            <div class="end"></div>
          </section>
        </>
      )}
      {notOnline && <p class="note-l">Some files are saved but not online yet.</p>}

      {mdPv && mdPv.html ? (
        <section class="pv" aria-labelledby="h-preview">
          <div class="sh"><h2 class="sl" id="h-preview">Preview</h2></div>
          <article class={previewCut ? 'pvt md' : 'pvt md whole'} lang={e.language || undefined} set:html={mdPv.html} />
          {readHref && <a class="more read" href={readHref}><span>{readLabel}</span><Icon name="go" class="chev" /></a>}
        </section>
      ) : preview.length > 0 ? (
        <section class="pv" aria-labelledby="h-preview">
          <div class="sh"><h2 class="sl" id="h-preview">Preview</h2></div>
          <article class={previewCut ? 'pvt' : 'pvt whole'} lang={e.language || undefined}>
            {preview.map((b) => (b.h ? <h3>{b.text}</h3> : <p>{b.text}</p>))}
          </article>
          {readHref && <a class="more read" href={readHref}><span>{readLabel}</span><Icon name="go" class="chev" /></a>}
        </section>
      ) : e.status === 'complete' && e.parts.some((p: any) => p.files.length > 0) && (
        <p class="note-l">No text preview: this doc is mostly images.</p>
      )}
    </div>

    <div class="side">
      {related.length > 0 && (
        <Blk label="Related" count={related.length} right="Words">
          <DocList entries={related} sort="none" cap={0} known={relatedKnown} />
          {relatedMore && <a class="more" href={relatedMore.href}><span>{relatedMore.label}</span><Icon name="go" class="chev" /></a>}
        </Blk>
      )}
      <Blk label="Details">
        <dl>
          {e.authors.length > 0 && e.sharedBy.length > 0 && (
            <div class="fact"><dt class="k">Shared by</dt><dd class="v">
              {e.sharedBy.map((x: any, i: number) => <>{i > 0 && ', '}<a class="il" href={`/authors/${x.key}/`}>{sharerName(x)}</a>{x.reddit && redditAccount(x.reddit) && <> <AccountFlag acct={redditAccount(x.reddit)} /></>}</>)}
            </dd></div>
          )}
          {e.variant && <div class="fact"><dt class="k">Version</dt><dd class="v">{e.variant}</dd></div>}
          {altTitles.length > 0 && (
            <div class="fact"><dt class="k">Also called</dt><dd class="v">{altTitles.slice(0, 3).join(', ')}{altTitles.length > 3 && <span class="sx"> +{altTitles.length - 3}</span>}</dd></div>
          )}
          {e.foundIn.length > 0 && (
            <div class="fact"><dt class="k">Listed in</dt><dd class="v">
              {e.foundIn.map((f: any) => (
                <p>
                  <a class="il" href={f.libraryUrl} rel="noopener">{f.libraryName}</a>
                  {[f.section && f.section.replace(/:$/, ''), f.character, f.linkText && f.linkText !== e.title && `listed as “${f.linkText}”`, f.note && readableDates(f.note)].filter(Boolean).map((x) => <span class="sx"> · {x}</span>)}
                </p>
              ))}
            </dd></div>
          )}
          {e.tagList.length > 0 && (
            <div class="fact"><dt class="k">Tags</dt><dd class="v">{e.tagList.map((t: any, i: number) => <>{i > 0 && ', '}<a class="il" href={`/tags/${t.id}/`}>{t.name}</a></>)}</dd></div>
          )}
          {e.links.length > 0 && (
            <div class="fact"><dt class="k">Links</dt><dd class="v">
              {e.links.map((l: any) => <p><a class="il" href={l.url} rel="noopener nofollow ugc">{l.label}</a>{l.note && <span class="sx"> · {readableDates(l.note)}</span>}</p>)}
            </dd></div>
          )}
          {e.notes && <div class="fact"><dt class="k">Notes</dt><dd class="v">{readableDates(e.notes)}</dd></div>}
          {statLine && <div class="fact"><dt class="k">Length</dt><dd class="v">{statLine}</dd></div>}
          {sizes.length > 0 && <div class="fact"><dt class="k">Files</dt><dd class="v">{sizes.join(', ')}</dd></div>}
          <div class="fact"><dt class="k">Language</dt><dd class="v">{e.languageName}</dd></div>
          {completion && <div class="fact"><dt class="k">Status</dt><dd class="v">{completion}</dd></div>}
          {statusLabel && <div class="fact"><dt class="k">Copy</dt><dd class="v">{statusLabel.statusLabel}</dd></div>}
          {savedDate && (
            <div class="fact"><dt class="k">{savedLabel === 'snapshot' ? 'Snapshot' : savedLabel === 'tried' ? 'Tried' : 'Saved'}</dt><dd class="v"><time datetime={savedDate}>{formatDate(savedDate)}</time></dd></div>
          )}
        </dl>
      </Blk>
      <div class="corr">
        <Fold label="Corrections and removal">
          {e.authors.length === 0 && <a class="more" href={correctionUrl}><span>Know who made it?</span><Icon name="go" class="chev" /></a>}
          {sortTopic && <a class="more" href={correctionUrl}><span>Help sort it</span><Icon name="go" class="chev" /></a>}
          <a class="more" href={correctionUrl}><span>Suggest a correction</span><Icon name="go" class="chev" /></a>
          <a class="more" href={`/removal/?item=${e.id}`}><span>Request removal</span><Icon name="go" class="chev" /></a>
          <a class="more" href={`${ARCHIVE_REPO_URL}/tree/main/${e.repoPath}`} rel="noopener"><span>Metadata on GitHub</span><Icon name="go" class="chev" /></a>
          {e.review.status === 'auto' && (
            <p class="note-l">Filled in automatically{e.review.check.length > 0 && <>; the {e.review.check.map((c: string) => checkNames[c] || c).join(', ')} may be wrong</>}.</p>
          )}
        </Fold>
        <div class="end"></div>
      </div>
    </div>
  </div>
</Base>

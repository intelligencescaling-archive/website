---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="prose">
    <h1>Page not found</h1>
    <p class="lede">That page isn't here. If it was an archived item, it may have been removed at its author's request.</p>
  </div>
  <form class="search-form nf-search" action="/search/" method="get" role="search">
    <label for="nf-q" class="visually-hidden">Search the archive</label>
    <input type="search" id="nf-q" name="q" placeholder="A character, a doc, a word inside a doc" enterkeyhint="search" />
    <button type="submit">Search</button>
  </form>
  <div class="prose">
    <p>
      Or browse: <a href="/search/">Search</a> · <a href="/series/">Series</a> · <a href="/characters/">Characters</a> ·{' '}
      <a href="/library/">Library</a> · <a href="/">Home</a>
    </p>
  </div>
</Base>

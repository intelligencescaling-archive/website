---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import RealMark from '../../components/RealMark.astro';
import { loadArchive, docsLabel, distinctAliases } from '../../lib/archive.mjs';

export function getStaticPaths() {
  return loadArchive().characters.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: any };
---
<Base title={c.name} section="characters" description={`${c.entries.length} archived docs about ${c.name}${c.seriesName ? ` (${c.seriesName})` : ''}.`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/characters/">Characters</a>
    {c.seriesId && <> / <a href={`/series/${c.seriesId}/`}>{c.seriesName}</a></>}
  </nav>
  <span class="tg-kind k-char">{c.real ? 'Character · real person' : 'Character'}</span>
  <h1>{c.name}{c.real && <RealMark />}</h1>
  {distinctAliases(c.name, c.aliases).length > 0 && <p class="alt-titles">Also known as: {distinctAliases(c.name, c.aliases).join(' · ')}</p>}
  <p class="lede">{docsLabel(c.entries.length)} · <a href={`/search/?character=${c.id}`}>Filter</a></p>
  <EntryList entries={c.entries} limit={c.entries.length > 100 ? 50 : undefined} moreHref={`/search/?character=${c.id}`} />
</Base>

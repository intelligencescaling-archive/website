---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { loadArchive } from '../../lib/archive.mjs';
const { series, entries } = loadArchive();
const noSeries = entries.filter((e) => e.series.length === 0).length;
---
<Base title="Series" section="series" description="Every series with archived docs and stories.">
  <div class="main">
    <h1>Series</h1>
    <p class="m1">{series.length} series · <a class="il" href="/search/?series=_none">{noSeries} docs with no series</a></p>
    <IndexList label="Series" noun="series" items={series.map((s) => ({ href: `/series/${s.id}/`, name: s.name, count: s.entries.length, match: s.aliases }))} />
  </div>
</Base>

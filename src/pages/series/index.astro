---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { loadArchive } from '../../lib/archive.mjs';
const { series, entries } = loadArchive();
const noSeries = entries.filter((e) => e.series.length === 0).length;
---
<Base title="Series" section="series" description="Every series with archived docs and stories.">
  <h1>Series</h1>
  <p class="lede">
    {series.length} series. {noSeries} more entries aren't about one series (SCD categories, scaling systems, guides,
    original characters): <a href="/browse/?series=_none">see those</a>.
  </p>
  <IndexList noun="series" items={series.map((s) => ({ href: `/series/${s.id}/`, name: s.name, count: s.entries.length, match: s.aliases }))} />
</Base>

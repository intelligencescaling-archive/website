---
// Home has one job: getting started. Everything to explore lives in Search and the Library.
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { loadArchive, formatNumber, recentlyAdded } from '../lib/archive.mjs';

const { entries, series, characters } = loadArchive();
// Shows up once docs arrive after the first import (submissions, new finds).
const recent = recentlyAdded(entries, 6);
const dateLabel = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const words = entries.reduce((n, e) => n + e.words, 0);
const popular = [...characters].sort((a, b) => b.entries.length - a.entries.length || a.name.localeCompare(b.name)).slice(0, 6);
---
<Base section="home">
  <section class="hero">
    <h1>Every r/<wbr />IntelligenceScaling doc, <span class="mark">saved and searchable.</span></h1>
    <form class="search-form" action="/search/" method="get" role="search">
      <label for="home-q" class="visually-hidden">Search the archive</label>
      <input type="search" id="home-q" name="q" placeholder="Character, doc or any word" enterkeyhint="search" />
      <button type="submit">Search</button>
      <a class="button secondary" href="/search/" data-random>Random doc</a>
    </form>
    <div class="popular">
      <h2 class="popular-h">Popular characters</h2>
      <ul class="chips">
        {popular.map((c) => <li><a class="chip" href={`/characters/${c.id}/`}>{c.name}</a></li>)}
      </ul>
    </div>
    <p class="stats-line">
      {formatNumber(entries.length)} docs · {formatNumber(characters.length)} characters · {formatNumber(series.length)} series · {(words / 1e6).toFixed(1)}M words
    </p>
  </section>
  {recent.length > 0 && (
    <section class="recent">
      <h2>Recently added</h2>
      <p class="small muted">Newest: {dateLabel(recent[0].added)}. <a href="/feed.xml">RSS feed</a> · <a href="/submit/">Submit a doc</a></p>
      <EntryList entries={recent} sort="none" />
    </section>
  )}
</Base>

<script>
  import { initRandom } from '../scripts/random.js';
  initRandom();
</script>

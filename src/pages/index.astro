---
// Home has one job: getting started. A search field, the most-documented characters and series, what's new.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DocList from '../components/DocList.astro';
import NameList from '../components/NameList.astro';
import { loadArchive, formatNumber, recentlyAdded } from '../lib/archive.mjs';

const { entries, series, characters } = loadArchive();
// Shows up once docs arrive after the first import (submissions, new finds).
const recent = recentlyAdded(entries, 6);
const words = entries.reduce((n, e) => n + e.words, 0);
const most = (xs: any[], n: number) => [...xs].sort((a, b) => b.entries.length - a.entries.length || a.name.localeCompare(b.name)).slice(0, n);
---
<Base section="home">
  <div class="main">
    <h1>Every r/<wbr />IntelligenceScaling doc, saved and searchable</h1>
    <p class="m1">
      {formatNumber(entries.length)} docs · {formatNumber(characters.length)} characters · {formatNumber(series.length)} series · {(words / 1e6).toFixed(1)}M words
    </p>
    <form class="home-s" action="/search/" method="get" role="search">
      <div class="sbox noclr">
        <Icon name="search" class="ic" />
        <label for="home-q" class="visually-hidden">Search the archive</label>
        <input type="search" id="home-q" name="q" placeholder="Character, doc or any word" enterkeyhint="search" autocomplete="off" />
      </div>
    </form>
    <div class="acts"><a class="tbtn" href="/search/" data-random>Random doc</a></div>
    <NameList
      label="Characters"
      items={most(characters, 8).map((c) => ({ href: `/characters/${c.id}/`, name: c.name, sub: c.seriesName, count: c.entries.length }))}
      cap={0}
      noun="characters"
      moreHref="/characters/"
      total={characters.length}
    />
    <NameList
      label="Series"
      items={most(series, 5).map((s) => ({ href: `/series/${s.id}/`, name: s.name, count: s.entries.length }))}
      cap={0}
      noun="series"
      moreHref="/series/"
      total={series.length}
    />
    {recent.length > 0 && <DocList label="Recently added" entries={recent} sort="none" cap={0} />}
  </div>
</Base>

<script>
  import { initRandom } from '../scripts/random.js';
  initRandom();
</script>

---
// One page for finding things. Empty box: the full list, with filters and sort (works without
// JavaScript as a plain list). Typed words: full-text search with the same filters.
// /browse/ redirects here (public/_redirects), with the same query parameters.
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { loadArchive, CATEGORY_PLURAL } from '../lib/archive.mjs';

const { entries, series, characters, authors, tags, languages, topics } = loadArchive();
const cats = Object.keys(CATEGORY_PLURAL).filter((c) => entries.some((e) => e.category === c));
// value = what goes in the URL (same as the old /browse/ links), pf = the Pagefind filter value.
const facets = [
  { key: 'cat', param: 'category', group: 'Category', label: 'Category', options: cats.map((c) => { const n = CATEGORY_PLURAL[c as keyof typeof CATEGORY_PLURAL]; return { v: c, n, pf: n }; }) },
  { key: 'series', param: 'series', group: 'Series', label: 'Series', options: [...series.map((s) => ({ v: s.id, n: s.name, pf: s.name })), { v: '_none', n: '(No series)', pf: '(No series)' }] },
  { key: 'topics', param: 'topic', group: 'Topic', label: 'Topic', options: topics.filter((t) => t.entries.length).map((t) => ({ v: t.id, n: t.name, pf: t.name })) },
  { key: 'chars', param: 'character', group: 'Character', label: 'Character', options: characters.map((c) => ({ v: c.id, n: c.name, pf: c.name })) },
  { key: 'authors', param: 'author', group: 'Author', label: 'Author', options: [{ v: '_unknown', n: 'Unknown author', pf: 'Unknown author' }, ...authors.map((a) => ({ v: a.key, n: a.name, pf: a.name }))] },
  { key: 'tags', param: 'tag', group: 'Tag', label: 'Tag', options: tags.map((t) => ({ v: t.id, n: t.name, pf: t.id })) },
  { key: 'lang', param: 'language', group: 'Language', label: 'Language', options: languages.map((l) => ({ v: l.id, n: l.name, pf: l.name })) },
];
---
<Base title="Search" section="search" description="Search inside every archived doc and story, or list them all and filter by series, character, author, tag and length.">
  <h1 class="search-h1">Search</h1>

  <form class="search-box" id="search-form" role="search" action="/search/" method="get">
    <label for="q" class="visually-hidden">Search titles, authors, characters and the text of every doc</label>
    <input type="search" id="q" name="q" autocomplete="off" enterkeyhint="search" placeholder="A character, a doc, a word inside a doc" />
    <button type="submit">Search</button>
  </form>
  <noscript><p class="note">Searching needs JavaScript. The full list is below, and you can also go by <a href="/series/">series</a>, <a href="/characters/">character</a> or <a href="/authors/">author</a>.</p></noscript>

  <div class="browse">
    <form class="filters" id="filters" aria-label="Filters" hidden>
      <div class="filters-head">
        <h2>Filters</h2>
        <button type="button" class="linklike" id="clear-filters">Clear all</button>
      </div>
      {facets.map((f) => (
        <div>
          <label for={`f-${f.key}`}>{f.label}</label>
          <select id={`f-${f.key}`} name={f.param} data-facet={f.key} data-group={f.group}>
            <option value="" data-label="Any">Any</option>
            {f.options.map((o) => <option value={o.v} data-label={o.n} data-pf={o.pf}>{o.n}</option>)}
          </select>
        </div>
      ))}
      <div class="filters-foot"><button type="button" id="sheet-done">Show results</button></div>
    </form>
    <div class="sheet-backdrop" id="sheet-backdrop"></div>

    <div>
      <div class="matches" id="matches" aria-live="polite" hidden></div>
      <div class="results-bar">
        <p class="results-count" id="status" aria-live="polite">{entries.length.toLocaleString('en-US')} entries</p>
        <div class="results-tools" id="tools" hidden>
          <label for="sort" class="visually-hidden">Order</label>
          <select id="sort">
            <option value="best">Best match</option>
            <option value="title">A–Z</option>
            <option value="long">Longest</option>
            <option value="short">Shortest</option>
          </select>
          <button type="button" class="secondary filter-toggle" id="filter-toggle" aria-controls="filters" aria-expanded="false">Filters</button>
        </div>
      </div>
      <ul class="chips active-filters" id="active" aria-label="Active filters" hidden></ul>
      <ol class="results" id="results" hidden></ol>
      <button type="button" class="secondary more" id="more" hidden>Show more results</button>
      <EntryList entries={entries} filterable id="list" />
      <p class="empty" id="empty" hidden>Nothing matches. <button type="button" class="linklike" id="clear-2">Clear all filters</button></p>
      <p class="small muted mt" id="dev-note" hidden>
        The search index only exists after a build. Run <code>npm run build</code> and <code>npm run preview</code>.
      </p>
    </div>
  </div>
</Base>

<script>
  import { initSearch } from '../scripts/search.js';
  initSearch();
</script>

---
import Base from '../../layouts/Base.astro';
import TagChip from '../../components/TagChip.astro';
import { loadArchive, TAG_GROUPS } from '../../lib/archive.mjs';
const { tags } = loadArchive();
// Groups in display order; a group the website doesn't name yet is listed under its id at the end.
const known = new Set(TAG_GROUPS.map((g) => g.id));
const extra = [...new Set(tags.map((t) => t.group).filter((g) => !known.has(g)))].map((id) => ({ id, name: id, desc: '' }));
const groups = [...TAG_GROUPS, ...extra].map((g) => ({ ...g, tags: tags.filter((t) => t.group === g.id) })).filter((g) => g.tags.length);
---
<Base title="Tags" description="Archive entries grouped by tag: feats, analysis, matchups, debunks, stories and more.">
  <div class="tag-index">
    <h1>Tags</h1>
    <p class="lede">What kind of doc it is. Each doc has one to three tags, plus notes about the saved file.</p>
    <nav class="tag-jump" aria-label="All tags">
      <ul class="chips">
        {groups.flatMap((g) => g.tags.filter((t: any) => t.entries.length)).map((t: any) => (
          <li><a class={`tg sm k-${t.group}`} href={`#t-${t.id}`}>{t.name} <span class="count">{t.entries.length}</span></a></li>
        ))}
      </ul>
    </nav>
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.id}`}>
        <h2 id={`g-${g.id}`}><span class={`tg-kind k-${g.id}`}>{g.name}</span></h2>
        {g.desc && <p class="small muted">{g.desc}</p>}
        <ul class="tag-group-list">
          {g.tags.map((t: any) => (
            <li id={`t-${t.id}`}>
              <TagChip tag={t} count={t.entries.length} />
              {t.definition && <p>{t.definition}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

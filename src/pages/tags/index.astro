---
// Every tag, by group: one row each (name, its definition as the meta line, doc count). The two "help sort" lists
// come last.
import Base from '../../layouts/Base.astro';
import { loadArchive, TAG_GROUPS } from '../../lib/archive.mjs';
const { tags, topics } = loadArchive();
const help = topics.filter((t: any) => t.help && t.entries.length);
// Groups in display order; a group the website doesn't name yet is listed under its id at the end.
const known = new Set(TAG_GROUPS.map((g) => g.id));
const extra = [...new Set(tags.map((t) => t.group).filter((g) => !known.has(g)))].map((id) => ({ id, name: id, desc: '' }));
const groups = [...TAG_GROUPS, ...extra].map((g) => ({ ...g, tags: tags.filter((t) => t.group === g.id) })).filter((g) => g.tags.length);
const used = tags.filter((t) => t.entries.length).length;
---
<Base section="tags" title="Tags" description="Archive entries grouped by tag: feats, analysis, matchups, debunks, stories and more.">
  <div class="main">
    <h1>Tags</h1>
    <p class="m1">{used} tags</p>
    {groups.map((g) => (
      <section class="sec" aria-labelledby={`g-${g.id}`}>
        <div class="sh"><h2 class="sl" id={`g-${g.id}`}>{g.name}</h2><span class="sl">Docs</span></div>
        <ul class="ls">
          {g.tags.map((t: any) => (
            <li id={`t-${t.id}`}>
              <a class="r2" href={`/tags/${t.id}/`}>
                <span class="t">{t.name}</span>
                <span class="ml"><span class="m">{t.definition || ' '}</span><span class="n">{t.entries.length.toLocaleString('en-US')}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="end"></div>
      </section>
    ))}
    {help.length > 0 && (
      <section class="sec" aria-labelledby="g-help">
        <div class="sh"><h2 class="sl" id="g-help">Help sort</h2><span class="sl">Docs</span></div>
        <ul class="ls">
          {help.map((t: any) => (
            <li>
              <a class="r2" href={`/topics/${t.id}/`}>
                <span class="t">{t.name}</span>
                <span class="ml"><span class="m">{t.desc || ' '}</span><span class="n">{t.entries.length.toLocaleString('en-US')}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="end"></div>
      </section>
    )}
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import DocList from '../../components/DocList.astro';
import { loadArchive, TAG_GROUPS, docsLabel } from '../../lib/archive.mjs';

export function getStaticPaths() {
  return loadArchive().tags.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: any };
const n = t.entries.length;
const group = TAG_GROUPS.find((g) => g.id === t.group) || TAG_GROUPS[0];
const oldNames = t.aliases.filter((a: string) => a.toLowerCase() !== t.name.toLowerCase());
---
<Base section="tags" title={`${t.name} (tag)`} description={`${docsLabel(n)} tagged ${t.name}.${t.definition ? ` ${t.definition}` : ''}`}>
  <div class="main">
    <h1>{t.name}</h1>
    <p class="m1"><a class="il" href="/tags/">{group.name}</a> · {docsLabel(n)}</p>
    {oldNames.length > 0 && <p class="m1">Also: {oldNames.join(', ')}</p>}
    {t.definition && <p class="desc">{t.definition}</p>}
    {n > 0 ? (
      <DocList label="Docs" entries={t.entries} skipTag={t.id} limit={n > 100 ? 50 : undefined} moreHref={`/search/?tag=${t.id}`} />
    ) : <p class="zero">No docs yet.</p>}
  </div>
</Base>

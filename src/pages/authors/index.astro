---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { loadArchive } from '../../lib/archive.mjs';
const { authors, removedAuthors, entries } = loadArchive();
const rows = [...authors, ...removedAuthors.map((a) => ({ ...a, removed: true, entries: [], reddit: null, match: [] }))].sort((a, b) =>
  a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }),
) as any[];
const unknown = entries.filter((e) => e.authors.length === 0).length;
---
<Base title="Authors" section="authors" description="Everyone whose work is preserved in the archive.">
  <div class="main">
    <h1>Authors</h1>
    <p class="m1">{authors.length} authors · <a class="il" href="/search/?author=_unknown">{unknown} docs by unknown authors</a></p>
    <IndexList
      label="Authors"
      noun="authors"
      items={rows.map((a) => ({
        href: `/authors/${a.key}/`,
        name: a.name,
        count: a.entries.length,
        mark: a.removed ? 'Work removed' : undefined,
        sub: a.reddit && a.reddit.toLowerCase() !== a.name.toLowerCase() ? `u/${a.reddit}` : null,
        match: a.match,
      }))}
    />
  </div>
</Base>

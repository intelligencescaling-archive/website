---
import Base from '../layouts/Base.astro';
import NameList from '../components/NameList.astro';
import { loadArchive } from '../lib/archive.mjs';
const { series, characters, authors, tags } = loadArchive();
const stories = tags.find((t: any) => t.id === 'story')?.entries.length || 0;
// The full list with filters is the Search page (empty search box), so it isn't repeated here.
const rows = [
  { href: '/characters/', name: 'Characters', count: characters.length },
  { href: '/series/', name: 'Series', count: series.length },
  { href: '/authors/', name: 'Authors', count: authors.length },
  { href: '/tags/', name: 'Tags', count: tags.filter((t: any) => t.entries.length).length },
  { href: '/tags/story/', name: 'Stories', count: stories },
];
---
<Base title="Library" section="library" description="Browse the archive by character, series, author or tag.">
  <div class="main">
    <h1>Library</h1>
    <NameList label="Browse" right="" items={rows} cap={0} noun="lists" />
  </div>
</Base>

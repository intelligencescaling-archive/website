---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { loadArchive, docsLabel } from '../../lib/archive.mjs';
import { ARCHIVE_REPO_URL } from '../../lib/config.mjs';

export function getStaticPaths() {
  return loadArchive()
    // Topics were folded into tags (2026-11-19): only the two "help sort" lists keep a page here; the old topic pages
    // redirect to their tag (public/_redirects).
    .topics.filter((t) => t.help && t.entries.length)
    .map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: any };
const tagGroup = new Map(loadArchive().tags.map((x: any) => [x.id, x.group]));
const n = t.entries.length;
const count = (tag: string) => t.entries.filter((e: any) => e.tags.includes(tag)).length;
const subs = (t.subs || []).map(([name, tag]: [string, string]) => ({ name, tag, n: count(tag) })).filter((s: any) => s.n > 0);
// "Series not known yet": the characters, so a reader who knows one can tell us its series.
const chars = new Map<string, { id: string; name: string; n: number }>();
if (t.id === 'series-unknown') {
  for (const e of t.entries) for (const c of e.characters) {
    const x = chars.get(c.id) || { id: c.id, name: c.name, n: 0 };
    x.n++;
    chars.set(c.id, x);
  }
}
const charList = [...chars.values()].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
const issueUrl = (title: string, body: string) =>
  `${ARCHIVE_REPO_URL}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
const helpUrl =
  t.id === 'series-unknown'
    ? issueUrl('Series for characters', 'Character:\nSeries it is from:\n')
    : issueUrl('Help sort entries', 'Entry (title or link):\nWhat it is about (series, characters, or a topic like SCD theory):\n');
---
<Base title={t.name} section="tags" description={`${docsLabel(n)} in ${t.name}. ${t.desc}`}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/tags/">Tags</a></nav>
  <h1>{t.name}</h1>
  <p class="lede">{docsLabel(n)}. {t.desc} <a href={`/search/?topic=${t.id}`}>Filter</a></p>

  {t.help && (
    <div class="note">
      <p>
        {t.id === 'series-unknown'
          ? 'Know which series one of these characters is from? '
          : 'Know what any of these are about? '}
        <a href={helpUrl} rel="noopener">Help sort them</a> (opens a GitHub issue).
      </p>
    </div>
  )}

  {subs.length > 1 && (
    <ul class="chips topic-subs" aria-label="Narrow down">
      {subs.map((s: any) => (
        <li><a class={`tg k-${tagGroup.get(s.tag) || 'type'}`} href={`/search/?topic=${t.id}&tag=${s.tag}`}>{s.name} <span class="count">{s.n}</span></a></li>
      ))}
    </ul>
  )}

  {charList.length > 0 && (
    <>
      <h2>Characters</h2>
      <ul class="chips">
        {charList.map((c) => <li><a class="chip" href={`/characters/${c.id}/`}>{c.name} <span class="count">{c.n}</span></a></li>)}
      </ul>
    </>
  )}

  <h2>Entries</h2>
  <EntryList entries={t.entries} limit={t.entries.length > 100 ? 50 : undefined} moreHref={`/search/?topic=${t.id}`} />
</Base>

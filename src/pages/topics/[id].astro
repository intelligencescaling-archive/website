---
import Base from '../../layouts/Base.astro';
import DocList from '../../components/DocList.astro';
import NameList from '../../components/NameList.astro';
import { loadArchive, docsLabel } from '../../lib/archive.mjs';
import { ARCHIVE_REPO_URL } from '../../lib/config.mjs';

export function getStaticPaths() {
  return loadArchive()
    // Topics were folded into tags (2026-11-19): only the two "help sort" lists keep a page here; the old topic pages
    // redirect to their tag (public/_redirects).
    .topics.filter((t) => t.help && t.entries.length)
    .map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: any };
const n = t.entries.length;
// "Series not known yet": the characters, so a reader who knows one can tell us its series.
const chars = new Map<string, { id: string; name: string; n: number }>();
if (t.id === 'series-unknown') {
  for (const e of t.entries) for (const c of e.characters) {
    const x = chars.get(c.id) || { id: c.id, name: c.name, n: 0 };
    x.n++;
    chars.set(c.id, x);
  }
}
const charList = [...chars.values()].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
const issueUrl = (title: string, body: string) =>
  `${ARCHIVE_REPO_URL}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
const helpUrl =
  t.id === 'series-unknown'
    ? issueUrl('Series for characters', 'Character:\nSeries it is from:\n')
    : issueUrl('Help sort entries', 'Entry (title or link):\nWhat it is about (series, characters, or a topic like SCD theory):\n');
---
<Base title={t.name} section="tags" description={`${docsLabel(n)} in ${t.name}. ${t.desc}`}>
  <div class="main">
    <h1>{t.name}</h1>
    <p class="m1"><a class="il" href="/tags/">Help sort</a> · {docsLabel(n)}</p>
    {t.desc && <p class="desc">{t.desc}</p>}
    {t.help && (
      <div class="acts"><a class="tbtn" href={helpUrl} rel="noopener">{t.id === 'series-unknown' ? 'Tell us a series' : 'Help sort them'}<span class="sx">GitHub</span></a></div>
    )}
    {charList.length > 0 && (
      <NameList label="Characters" items={charList.map((c) => ({ href: `/characters/${c.id}/`, name: c.name, count: c.n }))} cap={8} noun="characters" />
    )}
    <DocList label="Docs" entries={t.entries} limit={n > 100 ? 50 : undefined} moreHref={`/search/?topic=${t.id}`} />
  </div>
</Base>

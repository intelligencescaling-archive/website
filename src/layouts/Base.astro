---
import '../styles/global.css';
import { ARCHIVE_REPO_URL, SUBREDDIT_URL } from '../lib/config.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Which nav link is active. */
  section?: 'home' | 'search' | 'series' | 'topics' | 'characters' | 'authors' | 'library' | 'about';
  /** Open Graph type: 'article' for item pages, 'website' for the rest. */
  ogType?: 'website' | 'article';
}
const { title, description, section, ogType = 'website' } = Astro.props;
const siteName = 'Intelligence Scaling Archive';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc =
  description ||
  'A searchable archive of the analysis docs and stories shared on r/IntelligenceScaling (Smart Character Debates), with credit to their authors.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['search', '/search/', 'Search'],
  ['series', '/series/', 'Series'],
  ['topics', '/topics/', 'Topics'],
  ['characters', '/characters/', 'Characters'],
  ['authors', '/authors/', 'Authors'],
] as const;
// Phones (under 768 px) get a bottom tab bar instead of the top links: Home, Search, Library.
// Library holds Characters, Series, Topics, Authors and the full list.
const tab = section === 'home' ? 'home' : section === 'search' ? 'search' : section && section !== 'about' ? 'library' : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://files.intelscaling.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline src="/theme.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title || siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Intelligence Scaling Archive: the r/IntelligenceScaling community archive at intelscaling.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-current={section === 'home' ? 'page' : undefined}>
          Intelligence Scaling <span class="mark">Archive</span>
        </a>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between light and dark mode" hidden>
          <svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" fill="currentColor" /></svg>
          <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></g></svg>
        </button>
        <nav aria-label="Main">
          <ul>
            {nav.map(([key, href, label]) => (
              <li><a href={href} aria-current={section === key ? 'page' : undefined}><span>{label}</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p>
          A community archive for <a href={SUBREDDIT_URL} rel="noopener">r/IntelligenceScaling</a>.
          Archived content © its authors, removed on request.
        </p>
        <ul class="footer-links">
          <li><a href="/about/">About</a></li>
          <li><a href="/acknowledgments/">Acknowledgments</a></li>
          <li><a href="/removal/">Request removal</a></li>
          <li><a href={ARCHIVE_REPO_URL} rel="noopener">Archive on GitHub</a></li>
        </ul>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Main">
      <a href="/" aria-current={tab === 'home' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20h-5.5v-6h-5v6H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <span>Home</span>
      </a>
      <a href="/search/" aria-current={tab === 'search' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Search</span>
      </a>
      <a href="/library/" aria-current={tab === 'library' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 4v16M10 4v16M14.5 4.8l4.3 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Library</span>
      </a>
    </nav>
    <script is:inline src="/fold.js"></script>
  </body>
</html>

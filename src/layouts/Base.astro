---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ARCHIVE_REPO_URL, SUBREDDIT_URL } from '../lib/config.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Which nav link is active. */
  section?: 'home' | 'search' | 'series' | 'tags' | 'characters' | 'authors' | 'library' | 'about';
  /** Open Graph type: 'article' for item pages, 'website' for the rest. */
  ogType?: 'website' | 'article';
  /** Less space above the content (search page: the field sits right under the header). */
  tight?: boolean;
}
const { title, description, section, ogType = 'website', tight = false } = Astro.props;
const siteName = 'Intelligence Scaling Archive';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc =
  description ||
  'A searchable archive of the analysis docs and stories shared on r/IntelligenceScaling (Smart Character Debates), with credit to their authors.';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Main nav (rules.md 3: Series, Characters, Authors, Tags, About). Search is the header field (desktop) or the
// search icon (phones); on phones the links live in the menu sheet, with the theme switch.
const nav = [
  ['series', '/series/', 'Series'],
  ['characters', '/characters/', 'Characters'],
  ['authors', '/authors/', 'Authors'],
  ['tags', '/tags/', 'Tags'],
  ['about', '/about/', 'About'],
] as const;
const onSearch = section === 'search';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: https://files.intelscaling.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline src="/theme.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="New docs" href="/feed.xml" />
    <link rel="preload" href="/fonts/archivo-latin-v2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title || siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Intelligence Scaling Archive: the r/IntelligenceScaling community archive at intelscaling.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="hd">
      <div class="wrap hd-in">
        <a class="brand" href="/" aria-current={section === 'home' ? 'page' : undefined}>Intelligence Scaling<span class="wm">Archive</span></a>
        <span class="fill"></span>
        <nav class="nav" aria-label="Main">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        {!onSearch && (
          <a class="hs" href="/search/" aria-keyshortcuts="/"><Icon name="search16" /><span class="grow">Search</span><kbd>/</kbd></a>
        )}
        <button type="button" class="ib theme" data-toggle-theme aria-label="Switch theme"><Icon name="moon" class="moon" /><Icon name="sun" class="sun" /></button>
        {!onSearch && <a class="ib sp" href="/search/" aria-label="Search"><Icon name="search" /></a>}
        <a class="ib menu" id="menu-btn" href="/library/" aria-label="Menu" aria-expanded="false" aria-controls="menu-sheet">
          <Icon name="menu" class="i-menu" /><Icon name="x" class="i-x" />
        </a>
      </div>
    </header>
    <div class="sheet" id="menu-sheet" role="dialog" aria-label="Menu" hidden>
      <nav aria-label="Main">
        <ul>
          {nav.map(([key, href, label]) => (
            <li><a class="r1 nv" href={href} aria-current={section === key ? 'page' : undefined}><span class="nm"><span class="lb">{label}</span></span><Icon name="go" class="chev" /></a></li>
          ))}
          {/* Only while something is saved in this browser (html[data-has-saved], public/theme.js). */}
          <li class="sv-nav"><a class="r1 nv" href="/library/#saved"><span class="nm"><span class="lb">Saved</span></span><Icon name="go" class="chev" /></a></li>
        </ul>
        <div class="end"></div>
      </nav>
      <section class="sec">
        <div class="sh"><h2 class="sl">Theme</h2></div>
        <div class="tabs" role="group" aria-label="Theme">
          <button class="tb" type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
          <button class="tb" type="button" data-theme-set="light" aria-pressed="false">Light</button>
        </div>
      </section>
    </div>
    <main id="main">
      <div class={tight ? 'wrap pg tight' : 'wrap pg'}>
        <slot />
      </div>
    </main>
    <footer class="ft">
      <div class="wrap ft-in">
        <p>
          A community archive for <a class="il" href={SUBREDDIT_URL} rel="noopener">r/IntelligenceScaling</a>. Archived content
          © its authors, removed on request.
        </p>
        <ul class="ft-links">
          <li><a href="/submit/">Submit a doc</a></li>
          <li><a href="/library/">Library</a></li>
          <li><a href="/feed.xml">RSS</a></li>
          <li><a href="/acknowledgments/">Acknowledgments</a></li>
          <li><a href="/removal/">Request removal</a></li>
          <li><a href={ARCHIVE_REPO_URL} rel="noopener">GitHub</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline src="/fold.js"></script>
    <script>
      import { initSite } from '../scripts/site.js';
      initSite();
    </script>
  </body>
</html>

---
// One tag as a glyph chip (a link to its tag page). `count` adds a number; `current` marks the page's own tag.
interface Props {
  tag: { id: string; name: string; group: string };
  count?: number;
  current?: boolean;
}
const { tag, count, current = false } = Astro.props;
---
<a class={`tg k-${tag.group}`} href={`/tags/${tag.id}/`} aria-current={current ? 'page' : undefined}>{tag.name}{count !== undefined && <> <span class="count">{count}</span></>}</a>

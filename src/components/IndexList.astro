---
// A long alphabetical list (series, characters, authors): a type-to-filter box, an A–Z / Most docs sort and one
// 44px row per item. Sorting reuses the list code in src/scripts/site.js (data-w = docs, data-r = A–Z position).
import Icon from './Icon.astro';
interface Item {
  href: string;
  name: string;
  count: number;
  /** Shown instead of the count ("Work removed"). */
  mark?: string;
  sub?: string | null;
  /** Extra words the filter box should match (aliases, usernames). */
  match?: string[];
}
interface Props {
  items: Item[];
  noun: string;
  label: string;
}
const { items, noun, label } = Astro.props;
---
<div class="sbox noclr js-only ixf">
  <Icon name="search" class="ic" />
  <label for="index-q" class="visually-hidden">Filter {noun}</label>
  <input type="search" id="index-q" autocomplete="off" spellcheck="false" placeholder={`Filter ${noun}`} />
</div>
<section class="sec lhs">
  <div class="lh">
    <h2 class="sl">{label}</h2>
    <button class="sort js-only" type="button" aria-haspopup="menu" aria-expanded="false" data-sort-btn><span>A–Z · Docs</span><Icon name="down" /></button>
    <div class="pop" role="menu" hidden data-sort-pop>
      <button type="button" role="menuitemradio" aria-checked="false" data-sort="w" data-label="Most docs">Most docs</button>
      <button type="button" role="menuitemradio" aria-checked="true" data-sort="az" data-label="A–Z · Docs">A–Z</button>
    </div>
  </div>
  <ul class="ls" data-list data-sort="az" data-sorted="az" id="index-list">
    {items.map((it, i) => (
      <li data-name={[it.name, it.sub || '', ...(it.match || [])].join(' | ').toLowerCase()} data-w={it.count} data-r={i}>
        <a class="r1" href={it.href}>
          <span class="nm">{it.name}{it.sub && <span class="sx"> · {it.sub}</span>}</span>
          <span class="n">{it.mark || it.count.toLocaleString('en-US')}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="end"></div>
  <p class="zero" data-index-empty hidden>Nothing matches.</p>
</section>

<script>
  import { relist } from '../scripts/site.js';
  const input = document.getElementById('index-q') as HTMLInputElement | null;
  const list = document.getElementById('index-list') as HTMLElement | null;
  const empty = document.querySelector<HTMLElement>('[data-index-empty]');
  if (list) {
    const rows = [...list.children] as HTMLElement[];
    // ?sort=docs (shareable): most docs first.
    if (new URLSearchParams(location.search).get('sort') === 'docs') {
      document.querySelector<HTMLElement>('[data-sort="w"]')?.click();
    }
    list.addEventListener('listsort', () => {
      const url = new URL(location.href);
      if (list.dataset.sort === 'w') url.searchParams.set('sort', 'docs');
      else url.searchParams.delete('sort');
      history.replaceState(null, '', url);
    });
    input?.addEventListener('input', () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const r of rows) {
        const hit = terms.every((t) => (r.dataset.name || '').includes(t));
        r.classList.toggle('nomatch', !hit);
        if (hit) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    });
    relist(list);
  }
</script>

---
import { formatNumber, STATUS } from '../lib/archive.mjs';

interface Props {
  entries: any[];
  /** Adds data-* attributes used by the browse page's filter script. */
  filterable?: boolean;
  id?: string;
}
const { entries, filterable = false, id } = Astro.props;
const MAX_CHARS = 4;
const lc = (s: string) => s.toLowerCase();
---
<ul class="entries" id={id}>
  {entries.map((e) => (
    <li
      class="entry"
      data-cat={filterable ? e.category : undefined}
      data-series={filterable ? (e.series.length ? e.series.map((s: any) => s.id).join(' ') : '_none') : undefined}
      data-chars={filterable ? e.characters.map((c: any) => c.id).join(' ') : undefined}
      data-authors={filterable ? (e.authors.length ? e.authors.map((a: any) => a.key).join(' ') : '_unknown') : undefined}
      data-tags={filterable ? e.tags.join(' ') : undefined}
      data-lang={filterable ? e.language || 'unknown' : undefined}
      data-status={filterable ? e.status : undefined}
      data-words={filterable ? String(e.words) : undefined}
      data-text={filterable ? lc([e.title, ...e.altTitles, ...e.authors.map((a: any) => a.name)].join(' | ')) : undefined}
    >
      <div class="entry-title">
        <a href={`/items/${e.id}/`}>{e.title}</a>
        {e.category !== 'doc' && <> <span class="badge">{e.categoryName}</span></>}
        {e.status !== 'complete' && <> <span class={`badge ${STATUS[e.status].tone}`}>{STATUS[e.status].label}</span></>}
      </div>
      <div class="entry-meta">
        {e.authors.length ? (
          <span class="by">{e.authors.map((a: any) => a.name).join(', ')}</span>
        ) : (
          <span class="unknown">Unknown author</span>
        )}
        {e.series.length > 0 && <span>{e.series.map((s: any) => s.name).join(', ')}</span>}
        {e.characters.length > 0 && (
          <span>
            {e.characters.slice(0, MAX_CHARS).map((c: any) => c.name).join(', ')}
            {e.characters.length > MAX_CHARS && ` +${e.characters.length - MAX_CHARS} more`}
            {e.variant && ` (${e.variant})`}
          </span>
        )}
        {e.words > 0 && <span class="muted">{formatNumber(e.words)} words</span>}
      </div>
    </li>
  ))}
</ul>

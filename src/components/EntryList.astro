---
import { formatNumber, sharerName } from '../lib/archive.mjs';

interface Props {
  entries: any[];
  /** Adds data-* attributes used by the Search page's filter script. */
  filterable?: boolean;
  id?: string;
  /** 'long' (default): longest first. 'none': keep the order given (e.g. related docs by relevance). */
  sort?: 'long' | 'none';
  /** On a person's page: their key. They are left out of each row's authors and sharers (co-authors stay). */
  person?: string;
}
const { filterable = false, id, sort = 'long', person } = Astro.props;
// Position in A-Z order (the order loadArchive returns), so the Search page can switch back to A-Z.
const titleRank = new Map(Astro.props.entries.map((e: any, i: number) => [e, i]));
const entries = sort === 'long' ? [...Astro.props.entries].sort((a: any, b: any) => b.words - a.words || titleRank.get(a)! - titleRank.get(b)!) : Astro.props.entries;
const MAX_CHARS = 4;
// Leave out what every row in this list has in common (the series on a series page, the character
// on a character page, "Story" in a list of stories): it is already in the page's title.
const many = entries.length > 1;
const inAll = (pick: (e: any) => any[]) =>
  many ? new Set(pick(entries[0]).map((x: any) => x.id).filter((x: string) => entries.every((e) => pick(e).some((y: any) => y.id === x)))) : new Set();
const commonSeries = inAll((e) => e.series);
const commonChars = inAll((e) => e.characters);
const oneCategory = many && entries.every((e) => e.category === entries[0].category);
const commonTags = inAll((e) => e.tagList);
// The old status badge is left out when a meta tag already says it ("Original gone", "Text only").
const statusShown = (e: any) => e.status !== 'complete' && !(e.status === 'dead' || e.status === 'private' || (e.parts[0]?.recovered && e.tags.includes('text-only')));
---
<ul class="entries" id={id}>
  {entries.map((e) => {
    const seriesShown = e.series.filter((s: any) => !commonSeries.has(s.id));
    const charsShown = e.characters.filter((c: any) => !commonChars.has(c.id));
    const authorsShown = e.authors.filter((a: any) => a.key !== person);
    const sharersShown = e.sharedBy.filter((a: any) => a.key !== person);
    return (
    <li
      class="entry"
      data-cat={filterable ? e.category : undefined}
      data-series={filterable ? (e.series.length ? e.series.map((s: any) => s.id).join(' ') : '_none') : undefined}
      data-topics={filterable ? e.topics.map((t: any) => t.id).join(' ') : undefined}
      data-chars={filterable ? e.characters.map((c: any) => c.id).join(' ') : undefined}
      data-authors={filterable ? (e.authors.length ? e.authors.map((a: any) => a.key).join(' ') : '_unknown') : undefined}
      data-tags={filterable ? e.tags.join(' ') : undefined}
      data-lang={filterable ? e.language || 'unknown' : undefined}
      data-origin={filterable ? e.origins.map((o: any) => o.id).join(' ') : undefined}
      data-words={filterable ? String(e.words) : undefined}
      data-rank={filterable ? String(titleRank.get(e)) : undefined}
    >
      <div class="entry-title">
        <a href={`/items/${e.id}/`}>{e.title}</a>
        {e.category !== 'doc' && !oneCategory && <> <span class="badge cat">{e.categoryName}</span></>}
        {statusShown(e) && <> <span class={`badge ${e.tone}`}>{e.statusLabel}</span></>}
      </div>
      <div class="entry-meta">
        {authorsShown.length > 0 && <span class="by">{authorsShown.map((a: any) => a.name).join(', ')}</span>}
        {e.authors.length === 0 && sharersShown.length > 0 && <span class="sharer">shared by {sharersShown.map(sharerName).join(', ')}</span>}
        {seriesShown.length > 0 && <span>{seriesShown.map((s: any) => s.name).join(', ')}</span>}
        {charsShown.length > 0 && (
          <span>
            {charsShown.slice(0, MAX_CHARS).map((c: any) => c.name).join(', ')}
            {charsShown.length > MAX_CHARS && ` +${charsShown.length - MAX_CHARS} more`}
            {e.variant && ` (${e.variant})`}
          </span>
        )}
        {e.words > 0 && <span class="num">{formatNumber(e.words)} words</span>}
      </div>
      {e.tagList.some((t: any) => !commonTags.has(t.id)) && (
        <div class="tgs">{e.tagList.filter((t: any) => !commonTags.has(t.id)).map((t: any) => <span class={`tgb k-${t.group}`}>{t.name}</span>)}</div>
      )}
    </li>
    );
  })}
</ul>

---
// Reader view ("Book"): the full text of an entry, chapters in scroll mode. Long docs are split into pages of
// about 600 KB (readerPages in src/lib/archive.mjs): /items/<id>/read/, /items/<id>/read/2/, …
// For docs that also have a PDF/DOCX/…, a short note at the top says this is only the text and links to the original.
// Parts with reader blocks (blocks.json: the DOCX with images, colours and tables) are shown from those instead
// (src/lib/blocks.mjs), on the same pages and with the same #s-N targets; the note then isn't needed.
// The text is untrusted: plain text is only ever rendered through Astro expressions (escaped); rich parts go through
// set:html with HTML that blocks.mjs builds and escapes itself. Settings, progress, chapters, resume and the image
// viewer are in src/scripts/reader.js; without JavaScript the page is just the text and images.
import Base from '../layouts/Base.astro';
import { bylineText, formatNumber, textOnly, originalFile, readerUnit } from '../lib/archive.mjs';
import { richLayout, pageContext, renderPart, originalOf } from '../lib/blocks.mjs';
import '../styles/reader-rich.css';

interface Props {
  entry: any;
  chapters: any[];
  pages: any[];
  page: number; // 0-based
}
const { entry: e, chapters: all, pages, page } = Astro.props;
const here = pages[page];
const chapters = here.chapters;
const multi = all.length > 1;
const paged = pages.length > 1;
const unit = readerUnit(e);
const volumes = multi && unit === 'Volume';
const unitShort = volumes ? 'Vol' : unit;
const words = all.reduce((n: number, c: any) => n + c.words, 0);
const time = (w: number) => {
  const m = Math.max(1, Math.round(w / 230));
  return m < 60 ? `${m} min` : `${Math.floor(m / 60)} h ${m % 60} min`;
};
const readTime = time(words);
const itemHref = `/items/${e.id}/`;
const pageHref = (p: number) => (p === 0 ? `/items/${e.id}/read/` : `/items/${e.id}/read/${p + 1}/`);
// Page where each chapter starts (for the chapter list).
const startPage = new Map<number, number>();
pages.forEach((p: any, k: number) => p.chapters.forEach((c: any) => c.first && !startPage.has(c.i) && startPage.set(c.i, k)));
// Rich parts (null when none): their blocks laid out over the same pages.
const layout = richLayout(all, pages);
const isRich = (i: number) => Boolean(layout && layout.data[i]);
const allRich = all.every((_: any, i: number) => isRich(i));
const richHere = chapters.some((c: any) => isRich(c.i));
const rctx = layout ? pageContext({ layout, page, pageHref }) : null;
const richHtml = new Map<number, string>();
if (rctx) for (const c of chapters) if (isRich(c.i)) richHtml.set(c.i, renderPart(rctx, c.i, { multi, missHref: originalOf(e, all[c.i].n) || itemHref }));
const imageCount = rctx ? rctx.imgN : 0;
// "Go to" sheet: per part, its headings (`id`, doc-wide word offset `w`, page) for the list and the slider ticks.
// Plain parts: the text's headings (#s-<sid>); rich parts: the DOCX headings. Only the top two heading levels of a
// doc are listed; with more than 150, only the top level.
const pageOfSid = new Map<number, number>();
pages.forEach((p: any, k: number) => p.chapters.forEach((c: any) => c.blocks.forEach((b: any) => b.sid && pageOfSid.set(b.sid, k))));
const headsOf = all.map((c: any, i: number) =>
  isRich(i)
    ? layout.heads[i]
    : c.blocks.filter((b: any) => b.sid).map((b: any) => ({ id: `s-${b.sid}`, sid: b.sid, w: b.w, level: b.level, text: b.text, page: pageOfSid.get(b.sid) ?? 0 })),
);
const levels = [...new Set(headsOf.flat().map((h: any) => h.level))].sort();
let keep = levels.slice(0, 2);
if (headsOf.flat().filter((h: any) => keep.includes(h.level)).length > 150) keep = levels.slice(0, 1);
const outline = all.map((c: any, i: number) => {
  const end = c.w + c.words;
  const heads = headsOf[i].filter((h: any) => keep.includes(h.level));
  return {
    i, w: c.w, end, words: c.words,
    heads: heads.map((h: any, k: number) => ({
      id: h.id, sid: h.sid, w: h.w, text: h.text, sub: keep.length > 1 && h.level === keep[1],
      words: (heads[k + 1]?.w ?? end) - h.w, page: h.page,
    })),
  };
});
const hasNav = multi || outline[0].heads.length > 0 || words > 2000;
const idHref = (id: string, p: number) => (p === page ? `#${id}` : `${pageHref(p)}#${id}`);
const chHref = (i: number) => { const p = startPage.get(i) ?? 0; return p === page ? `#ch-${i + 1}` : `${pageHref(p)}#ch-${i + 1}`; };
const original = textOnly(e) ? null : originalFile(e);
const hasOriginal = !textOnly(e) && !allRich;
// Headings from the text sit one level under the chapter heading.
const base = multi ? 3 : 2;
const tagFor = (level: number) => (level === 0 ? 'p' : `h${Math.min(base + level - 1, 6)}`);
const title = paged ? `Read: ${e.title} (page ${page + 1} of ${pages.length})` : `Read: ${e.title}`;
---
<Base title={title} description={`Read ${e.title} ${bylineText(e)} on the Intelligence Scaling Archive.`} ogType="article">
  <meta slot="head" name="robots" content="noindex, follow" />
  {layout && <link slot="head" rel="stylesheet" href={`/items/${e.id}/read/doc.css`} />}
  <div class="reader" id="reader" data-id={e.id} data-unit={unit} data-page={page + 1} data-pages={pages.length}
    data-before={here.wordsBefore} data-total={words} data-prev={page > 0 ? pageHref(page - 1) : undefined}
    data-next={page < pages.length - 1 ? pageHref(page + 1) : undefined} data-base={pageHref(0)}
    data-starts={pages.map((p: any) => p.wordsBefore).join(',')} data-short={unitShort} data-rich={layout ? '1' : undefined}>
    <div class="r-bar">
      <a class="r-icon" href={itemHref} aria-label="Back to the item page">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </a>
      <span class="r-title">{e.title}</span>
      <button type="button" class="r-icon r-aa" id="r-aa" aria-label="Text settings" aria-haspopup="dialog" hidden>Aa</button>
      {hasNav && (
        <button type="button" class="r-icon" id="r-toc" aria-label={multi ? `Go to: ${unit.toLowerCase()}s and position` : 'Go to: sections and position'} aria-haspopup="dialog" aria-keyshortcuts="g" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
        </button>
      )}
    </div>

    <article class="r-page" id="r-page" lang={e.language || undefined}>
      {hasOriginal && (
        <p class="r-note">
          <span>Text version. Images, colours and tables are only in the original.</span>
          {original && !original.multi ? (
            <a href={original.href} rel="noopener">{original.format === 'pdf' ? 'Open the PDF' : `Open the ${original.formatName}`}</a>
          ) : (
            <a href={itemHref}>See the original files</a>
          )}
        </p>
      )}
      {page > 0 && (
        <nav class="r-pager r-pager-top" aria-label="Pages">
          <a href={pageHref(page - 1)} rel="prev">← Page {page}</a>
          <span>Page {page + 1} of {pages.length}</span>
        </nav>
      )}
      {multi && page === 0 && (
        <header class="r-book">
          <h1>{e.title}</h1>
          <p class="r-by">{bylineText(e)}</p>
          <p class="r-meta">{all.length} {unit.toLowerCase()}s · {formatNumber(words)} words · about {readTime}{paged && ` · ${pages.length} pages`}</p>
        </header>
      )}
      {chapters.map((c: any) => {
        const n = c.i + 1;
        const id = c.first ? `ch-${n}` : `ch-${n}-more`;
        // Words of this chapter on later pages (for "min left in chapter").
        const after = c.cont ? pages.slice(page + 1).flatMap((p: any) => p.chapters).filter((x: any) => x.i === c.i).reduce((k: number, x: any) => k + x.words, 0) : 0;
        return (
          <section class="r-ch" id={id} data-n={n} data-words={c.words} data-after={after || undefined} aria-labelledby={`${id}-h`}>
            {multi ? (
              <>
                <p class="r-chap">{unit} {n} of {all.length}{!c.first && ', continued'}</p>
                <h2 id={`${id}-h`}>{c.title || `${unit} ${n}`}</h2>
              </>
            ) : c.first ? (
              <>
                <h1 id={`${id}-h`}>{e.title}</h1>
                <p class="r-by">{bylineText(e)} · {formatNumber(words)} words · about {readTime}{paged && ` · ${pages.length} pages`}</p>
              </>
            ) : (
              <h1 class="visually-hidden" id={`${id}-h`}>{e.title}, page {page + 1}</h1>
            )}
            {richHtml.has(c.i) ? (
              <div class="r-text r-rich" set:html={richHtml.get(c.i)} />
            ) : (
              <div class="r-text">
                {c.blocks.map((b: any) => {
                  const Tag = tagFor(b.level);
                  // data-w (word offset) only next to rich parts, where the script can't count words from the text.
                  const w = richHere ? b.w : undefined;
                  return b.cont ? <Tag class="r-cont" data-w={w}>{b.text}</Tag> : b.sid ? <Tag id={`s-${b.sid}`} data-w={w}>{b.text}</Tag> : <Tag data-w={w}>{b.text}</Tag>;
                })}
              </div>
            )}
          </section>
        );
      })}
      {page < pages.length - 1 ? (
        <nav class="r-pager r-pager-end" aria-label="Pages">
          <span>Page {page + 1} of {pages.length}</span>
          <a class="btn" href={pageHref(page + 1)} rel="next">Next page ({time(pages[page + 1].words)}) →</a>
        </nav>
      ) : (
        <p class="r-end"><a href={itemHref}>Back to {e.title}</a></p>
      )}
    </article>

    <div class="r-foot" id="r-foot" hidden>
      <div class="r-resume" id="r-resume" role="region" aria-label="Continue reading" hidden>
        <button type="button" class="r-resume-go" id="r-resume-go">Continue where you left off <span id="r-resume-where"></span></button>
        <button type="button" class="r-icon r-resume-x" id="r-resume-x" aria-label="Dismiss">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="r-track" aria-hidden="true"><i id="r-fill"></i></div>
      {hasNav ? (
        <button type="button" class="r-status r-status-btn" id="r-goto" aria-haspopup="dialog">
          <span class="visually-hidden">Go to. Now at: </span>
          <span class="r-where" id="r-where"></span>
          <span class="r-left"><span id="r-left"></span><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg></span>
        </button>
      ) : (
        <div class="r-status"><span class="r-where" id="r-where"></span><span class="r-left" id="r-left"></span></div>
      )}
    </div>
  </div>

  <dialog class="r-sheet r-settings" id="r-settings" aria-labelledby="r-settings-h">
    <div class="r-grab" aria-hidden="true"></div>
    <h2 id="r-settings-h" class="visually-hidden">Text settings</h2>
    <div class="r-row">
      <span id="r-l-size">Text size</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-size">
        <button type="button" data-size="-1" aria-label="Smaller text">A−</button>
        <output id="r-size" aria-live="polite">18</output>
        <button type="button" data-size="1" aria-label="Bigger text">A+</button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-theme">Theme</span>
      <div class="r-swatches" role="group" aria-labelledby="r-l-theme">
        <button type="button" class="r-sw r-sw-light" data-theme-pick="light" aria-label="Light" aria-pressed="false"></button>
        <button type="button" class="r-sw r-sw-sepia" data-theme-pick="sepia" aria-label="Sepia" aria-pressed="false"></button>
        <button type="button" class="r-sw r-sw-dark" data-theme-pick="dark" aria-label="Dark" aria-pressed="false"></button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-lh">Line spacing</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-lh">
        <button type="button" data-lh="tight" aria-pressed="false">Tight</button>
        <button type="button" data-lh="normal" aria-pressed="false">Normal</button>
        <button type="button" data-lh="loose" aria-pressed="false">Loose</button>
      </div>
    </div>
    <div class="r-row">
      <span id="r-l-w">Width</span>
      <div class="r-seg" role="group" aria-labelledby="r-l-w">
        <button type="button" data-w="narrow" aria-pressed="false">Narrow</button>
        <button type="button" data-w="medium" aria-pressed="false">Medium</button>
        <button type="button" data-w="wide" aria-pressed="false">Wide</button>
      </div>
    </div>
    <button type="button" class="r-done" data-close>Done</button>
  </dialog>

  {imageCount > 0 && (
    <dialog class="r-lb" id="r-lb" aria-label="Image viewer">
      <div class="r-lb-top">
        <span class="r-lb-n" id="r-lb-n" aria-live="polite"></span>
        <button type="button" class="r-icon" id="r-lb-x" aria-label="Close image">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="r-lb-pane" id="r-lb-pane"><div class="r-lb-fr" id="r-lb-fr"></div></div>
      <button type="button" class="r-icon r-lb-p" id="r-lb-p" aria-label="Previous image">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button type="button" class="r-icon r-lb-nx" id="r-lb-nx" aria-label="Next image">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
      </button>
    </dialog>
  )}

  {hasNav && (
    <dialog class="r-sheet r-nav" id="r-nav" aria-labelledby="r-nav-h">
      <div class="r-grab" aria-hidden="true"></div>
      <div class="r-sheet-head">
        <h2 id="r-nav-h">Go to</h2>
        <button type="button" class="r-icon" data-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      {volumes && (
        <div class="r-seg r-vols" role="group" aria-label="Volumes">
          {all.map((c: any, i: number) => (
            <button type="button" data-vol={i} aria-pressed="false">Volume {i + 1}<small>{time(c.words)}</small></button>
          ))}
        </div>
      )}
      <div class="r-jump" hidden>
        <div class="r-jump-top"><label for="r-range" id="r-jump-at">Position</label><span>Drag to jump</span></div>
        <input type="range" id="r-range" min="0" max="1000" step="1" value="0" />
        <div class="r-ticks" id="r-ticks" aria-hidden="true"></div>
      </div>
      <div class="r-lists">
        {outline.map((o: any) => (multi || o.heads.length > 0) && (
          <ol class={`r-toc${multi && !volumes ? ' r-toc-nested' : ''}`} data-vol={o.i} aria-label={multi ? all[o.i].title || `${unit} ${o.i + 1}` : 'Sections'}>
            {multi && (
              <li>
                <a class={volumes ? 'r-toc-part r-toc-s' : 'r-toc-part'} href={chHref(o.i)} data-ch={o.i + 1} data-w={o.w}>
                  {!volumes && <span class="r-toc-n">{o.i + 1}</span>}
                  <span class="r-toc-t">{volumes ? `Start of volume ${o.i + 1}` : all[o.i].title || `${unit} ${o.i + 1}`}</span>
                  <span class="r-toc-m">{time(o.words)}</span>
                </a>
              </li>
            )}
            {o.heads.map((h: any) => (
              <li>
                <a class={h.sub ? 'r-toc-s r-toc-sub' : 'r-toc-s'} href={idHref(h.id, h.page)} data-s={h.sid} data-hid={h.sid ? undefined : h.id} data-w={h.w}>
                  <span class="r-toc-t">{h.text}</span>
                  <span class="r-toc-m">{time(h.words)}</span>
                </a>
              </li>
            ))}
          </ol>
        ))}
      </div>
      <div class="r-nav-btns">
        <a class="tbtn" href={pageHref(0)} id="r-start">Back to start</a>
        <button type="button" data-close>Done</button>
      </div>
    </dialog>
  )}
</Base>

<script>
  import { initReader } from '../scripts/reader.js';
  initReader();
</script>

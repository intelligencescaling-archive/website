---
// A person's contact handles as fact rows: platform on the left, the handle (a link for platforms with profile
// pages), and a Copy text button for names people type into an app (Discord, Telegram). Handles are untrusted text:
// rendered with Astro expressions only.
import AccountFlag from './AccountFlag.astro';
interface Contact { platform: string; platformName: string; handle: string; label: string; url: string | null; copy: boolean; acct?: { flag: string; note: string } }
interface Props { contacts: Contact[]; notes?: string[] }
const { contacts, notes = [] } = Astro.props;
---
<section class="sec main contact" id="contact" aria-labelledby="contact-h">
  <div class="sh"><h2 id="contact-h" class="sl">Contact</h2></div>
  <ul>
    {contacts.map((c) => (
      <li class={`fact ct p-${c.platform}`}>
        <span class="k">{c.platformName}</span>
        <span class="v">
          {c.url ? <a href={c.url} rel="noopener nofollow ugc"><span class="ct-handle">{c.label}</span></a> : <span class="ct-handle">{c.label}</span>}
          {c.acct && <> <AccountFlag acct={c.acct} /></>}
        </span>
        {c.copy && (
          <button type="button" class="tbtn ct-copy" data-copy={c.handle} aria-label={`Copy ${c.platformName} name ${c.label}`}>
            <span class="ct-copy-txt">Copy</span>
          </button>
        )}
      </li>
    ))}
  </ul>
  <div class="end"></div>
  {notes.map((n) => <p class="note-l">{n}</p>)}
  <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
  // Copy buttons: copies the handle, shows "Copied" for 2 s and tells screen readers. Without the Clipboard API
  // (old browsers, http) it selects the handle so it can be copied by hand.
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    const txt = b.querySelector<HTMLElement>('.ct-copy-txt');
    let timer: ReturnType<typeof setTimeout> | undefined;
    b.addEventListener('click', async () => {
      const value = b.dataset.copy || '';
      let ok = false;
      try {
        // Some browsers never settle the promise without permission: give up after 1.5 s and select instead.
        await Promise.race([navigator.clipboard.writeText(value), new Promise((_, no) => setTimeout(no, 1500))]);
        ok = true;
      } catch {
        const handle = b.parentElement?.querySelector('.ct-handle');
        const sel = getSelection();
        if (handle && sel) {
          const r = document.createRange();
          r.selectNodeContents(handle);
          sel.removeAllRanges();
          sel.addRange(r);
        }
      }
      if (txt) txt.textContent = ok ? 'Copied' : 'Selected';
      if (status) status.textContent = ok ? `Copied ${value}` : `Selected ${value}. Copy it from your browser's menu.`;
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (txt) txt.textContent = 'Copy';
      }, 2000);
    });
  }
</script>

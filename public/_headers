# Cloudflare Pages response headers. Keep the CSP in sync with src/layouts/Base.astro.
# static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics (cookie-free visit counts).
# challenges.cloudflare.com: Turnstile, the spam check on the Submit form.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: https://files.intelscaling.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind's index and fragment files have content hashes in their names, so they never change.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change in place (a new version gets a new file name).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
